node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Compositions are assets - the src/compositions/ symlink points to the
# shared assets directory (PIPELINE_REMOTION_COMPOSITIONS env var).
# (Comment retained for history; directory is currently tracked)

# Brand assets are project-specific and populated at render time.
public/brand/*
!public/brand/README.md

# Props files are generated per-project render
public/*Props.json
build

# Bookend staging (library/tools/bookend_render.py). A project's own
# composition is copied in verbatim and given a generated entry point so
# it can be rendered without touching the committed Root.tsx; its sibling
# assets land at the public root, because that is the only place
# staticFile() resolves. All of it is build output, rewritten per render.
src/staged/
/public/*
!/public/*/
