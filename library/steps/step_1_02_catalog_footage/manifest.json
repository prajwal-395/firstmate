{
  "id": "step_1_02_catalog_footage",
  "name": "Catalog Footage",
  "version": "1.0.0",
  "description": "Catalogs the raw footage files into a structured clip catalog.",
  "level": "step",
  "interface": {
    "inputs": [
      {
        "name": "raw_footage_files",
        "type": "array",
        "required": true,
        "description": "State input: raw_footage_files"
      }
    ],
    "outputs": [
      {
        "name": "clip_catalog",
        "type": "array",
        "description": "State output: clip_catalog"
      },
      {
        "name": "skipped_files",
        "type": "array",
        "description": "State output: skipped_files"
      },
      {
        "name": "total_clips",
        "type": "int",
        "description": "State output: total_clips"
      },
      {
        "name": "project_fps",
        "type": "number",
