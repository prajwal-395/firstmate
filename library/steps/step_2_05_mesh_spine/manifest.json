{
  "id": "step_2_05_mesh_spine",
  "name": "Mesh Spine",
  "version": "1.0.0",
  "description": "Meshes the speech sequence with music selection into a unified audio and timed spine.",
  "level": "step",
  "interface": {
    "inputs": [
      {
        "name": "brand_content",
        "type": "object",
        "required": false,
        "description": "Brand template content slots. Only content.bookends is read: it declares the intro / outro / end card this template gets, and a template declaring none gets none."
      },
      {
        "name": "music_analysis",
        "type": "object",
        "required": true,
        "description": "State input: music_analysis"
      },
      {
        "name": "music_selection",
        "type": "object",
        "required": true,
        "description": "State input: music_selection"
      },
      {
        "name": "speech_sequence",
        "type": "object",
        "required": true,
        "description": "State input: speech_sequence"
      },
      {
        "name": "temporal_index",
        "type": "array",
        "required": true,
        "description": "State input: temporal_index"
      }
    ],
    "outputs": [
      {
        "name": "audio_spine",
        "type": "object",
        "description": "State output: audio_spine",
        "expected_schema": "resolve_manifest.py"
      },
      {
        "name": "timed_spine",
        "type": "object",
        "description": "State output: timed_spine",
        "expected_schema": {
          "total_estimated_duration_seconds": "float",
          "structure": "list"
        }
      }
    ],
    "preconditions": [
      "'speech_sequence' exists in state",
      "'music_selection' exists in state",
      "'temporal_index' exists in state",
      "'music_analysis' exists in state"
    ],
    "postconditions": [
      "'audio_spine' is written to state",
      "'timed_spine' is written to state"
    ],
    "llm_outputs": [
      {
        "name": "structure",
        "type": "list",
        "required": true,
        "description": "Ordered spine blocks. Each block: position (\"hook\" or int), block_type (\"hook\"|\"speech\"|\"transition_slot\") and duration_seconds. A \"hook\"/\"speech\" block also carries content.passage_ref matching a speech_sequence position. Do NOT write \"intro\", \"outro\" or \"end_card\" blocks: those come from the brand template's content.bookends and the bridge drops any the plan invents"
      }
    ]
  },
  "classification": {
    "determinism": "hybrid",
    "archetype": "data_transformation",
    "idempotent": false
  },
  "dependencies": [
    "step_2_02_speech_sequence",
    "step_2_04_music_selection",
    "step_2_06_music_analysis"
  ],
  "tags": [
    "data_transformation",
    "video-editing",
    "nondeterministic"
  ],
  "domain": "video-editing",
  "implementation": {
    "default": {
      "runtime": "llm",
      "entry_point": "handoff.md"
    },
    "variants": {},
    "test_entry_point": ""
  },
  "metadata": {
    "author": "prajwal",
    "created": "2026-07-20",
    "last_modified": "2026-07-20",
    "source_process": "video_editing_pipeline"
  }
}
