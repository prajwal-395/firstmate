{
  "id": "step_5_01_color_grade",
  "name": "Color Grade",
  "version": "1.0.0",
  "description": "Specifies color grading settings for A-roll and B-roll clips.",
  "level": "step",
  "interface": {
    "inputs": [
      {
        "name": "creative_direction",
        "type": "object",
        "required": true,
        "description": "State input: creative_direction"
      },
      {
        "name": "a_roll_assignments",
        "type": "array",
        "required": true,
        "description": "State input: a_roll_assignments"
      },
      {
        "name": "b_roll_assignments",
        "type": "array",
        "required": true,
        "description": "State input: b_roll_assignments"
      },
      {
        "name": "project_folder",
        "type": "string",
        "required": false,
        "description": "Path to the project folder, needed for ffprobe media analysis"
      },
      {
        "name": "brand_style",
        "type": "object",
        "required": false,
        "description": "Brand style slots"
      }
    ],
    "outputs": [
      {
        "name": "color_grade_spec",
        "type": "object",
        "description": "State output: color_grade_spec"
      }
    ],
    "preconditions": [
