{
  "id": "step_4_02_plan_transitions",
  "name": "Plan Transitions",
  "version": "1.0.0",
  "description": "Plans transitions between A-roll and B-roll clips based on creative direction.",
  "level": "step",
  "interface": {
    "inputs": [
      {
        "name": "a_roll_assignments",
        "type": "array",
        "required": true,
        "description": "State input: a_roll_assignments"
      },
      {
        "name": "b_roll_assignments",
        "type": "array",
        "required": true,
        "description": "State input: b_roll_assignments"
      },
      {
        "name": "creative_direction",
        "type": "object",
        "required": true,
        "description": "State input: creative_direction"
      },
      {
        "name": "music_selection",
        "type": "object",
        "required": true,
        "description": "State input: music_selection"
      },
      {
        "name": "rough_cut_review",
        "type": "object",
        "required": true,
        "description": "State input: rough_cut_review"
      },
      {
        "name": "semantic_analysis",
        "type": "array",
        "required": false,
        "description": "Semantic analysis output"
      },
      {
        "name": "temporal_event_indices",
        "type": "array",
        "required": true,
        "description": "State input: temporal_event_indices"
      },
      {
        "name": "timed_spine",
        "type": "object",
        "required": true,
        "description": "State input: timed_spine"
      }
    ],
    "outputs": [
      {
        "name": "cuts_toon",
        "type": "string",
        "description": "State output: cuts_toon"
      },
      {
        "name": "transition_spec",
        "type": "array",
        "description": "State output: transition_spec",
        "expected_schema": {
          "transition_creative": "list"
        }
      }
    ],
    "preconditions": [
      "'a_roll_assignments' exists in state",
      "'b_roll_assignments' exists in state",
      "'creative_direction' exists in state",
      "'rough_cut_review.passed' is true in state"
    ],
    "postconditions": [
      "'transition_spec' is written to state"
    ],
    "llm_outputs": [
      {
        "name": "transition_creative",
        "type": "list",
        "required": true,
        "description": "One entry per cut, each at a DISTINCT cut_point_position (the spine position of the INCOMING block). Fields: cut_point_position, type, duration_feel, rationale"
      }
    ]
  },
  "classification": {
    "determinism": "hybrid",
    "archetype": "content_generation",
    "idempotent": false
  },
  "dependencies": [
    "step_3_01_assign_aroll",
    "step_3_02_select_broll",
    "step_3_03_review_rough_cut"
  ],
  "tags": [
    "content_generation",
    "video-editing",
    "nondeterministic"
  ],
  "domain": "video-editing",
  "implementation": {
    "default": {
      "runtime": "python",
      "entry_point": "bridge.py"
    },
    "variants": {},
    "test_entry_point": ""
  },
  "metadata": {
    "author": "prajwal",
    "created": "2026-07-20",
    "last_modified": "2026-07-20",
    "source_process": "video_editing_pipeline"
  },
  "context_fields": [
    "a_roll_assignments",
    "b_roll_assignments",
    "creative_direction",
    "music_selection",
    "rough_cut_review",
    "timed_spine",
    "temporal_event_indices.*.clip_id",
    "temporal_event_indices.*.scene_boundaries"
  ]
}
