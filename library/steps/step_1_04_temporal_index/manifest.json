{
  "id": "step_1_04_temporal_index",
  "name": "Temporal Index",
  "version": "1.0.0",
  "description": "Creates a temporal index of footage using WhisperX and Librosa.",
  "level": "step",
  "interface": {
    "inputs": [
      {
        "name": "raw_footage_files",
        "type": "array",
        "required": true,
        "description": "State input: raw_footage_files"
      }
    ],
    "outputs": [
      {
        "name": "index_dir",
        "type": "string",
        "description": "State output: index_dir"
      },
      {
        "name": "source",
        "type": "string",
        "description": "State output: source"
      },
      {
        "name": "temporal_event_indices",
        "type": "array",
        "description": "State output: temporal_event_indices"
      },
      {
        "name": "total_failed",
        "type": "int",
        "description": "State output: total_failed"
      },
      {
        "name": "total_indexed",
        "type": "int",
        "description": "State output: total_indexed"
      },
      {
        "name": "total_reused",
        "type": "int",
        "may_be_empty": true,
        "description": "Clips whose per-clip index was reused from disk rather than re-transcribed. `may_be_empty` because ZERO IS THE CORRECT VALUE on a run that transcribed everything fresh - which is every first run, and was project 001's run of record. run_pipeline.validate_step_output treats any `total_*` output of 0 as semantically empty, so without this the honest answer was reported as a defect."
      }
    ]
  },
  "classification": {
    "stage": "preflight",
    "determinism": "deterministic",
    "archetype": "data_transformation",
    "idempotent": true,
    "per_clip_artifacts": [
      "{area:temporal_index}/{clip_id}.json",
      "{area:audio_cache}/{clip_id}.wav"
    ]
  },
  "dependencies": [
    "step_1_01_scan_project"
  ],
  "tags": [
    "data_transformation",
    "video-editing",
    "deterministic"
  ],
  "domain": "video-editing",
  "implementation": {
    "default": {
      "runtime": "python",
      "entry_point": "step.py"
    },
    "variants": {},
    "test_entry_point": ""
  },
  "metadata": {
    "author": "prajwal",
    "created": "2026-07-20",
    "last_modified": "2026-07-20",
    "source_process": "video_editing_pipeline"
  }
}
