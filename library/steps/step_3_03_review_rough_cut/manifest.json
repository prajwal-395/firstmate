{
  "id": "step_3_03_review_rough_cut",
  "name": "Review Rough Cut",
  "version": "1.0.0",
  "description": "Quality gate that validates the assembled rough cut for duration consistency, narrative coherence, and complete thoughts before proceeding to planning phases. Rejects manifests with mismatched source/timeline durations or incoherent narrative flow.",
  "level": "step",
  "interface": {
    "inputs": [
      {
        "name": "a_roll_assignments",
        "type": "array",
        "required": true,
        "description": "State input: a_roll_assignments"
      },
      {
        "name": "audio_spine",
        "type": "object",
        "required": true,
        "description": "State input: audio_spine"
      },
      {
        "name": "b_roll_assignments",
        "type": "array",
        "required": true,
        "description": "State input: b_roll_assignments"
      },
      {
        "name": "b_roll_interjections",
        "type": "array",
        "required": false,
        "description": "State input: b_roll_interjections"
      },
      {
        "name": "creative_direction",
        "type": "object",
        "required": true,
        "description": "State input: creative_direction"
      },
      {
        "name": "project_config",
        "type": "object",
        "required": false,
        "description": "State input: project_config"
      },
      {
        "name": "render_qa_findings",
        "type": "object",
        "required": false,
        "description": "The LAST render's QA findings, read off exports/qa_report.json by library/tools/qa_findings.py. No DAG edge carries it: the producer is step 6.02, the final node, so an edge here would be a back edge and the topological sort would refuse it. It is filled by name in gather_step_inputs for the steps that declare it, and it is absent on a project that has never rendered. It carries its own legend, because handoff.md is frozen. NOT a gate: an advisory finding must never reject a rough cut."
      },
      {
        "name": "speech_sequence",
        "type": "object",
        "required": true,
        "description": "State input: speech_sequence"
      },
      {
        "name": "temporal_index",
        "type": "array",
        "required": false,
        "description": "State input: temporal_index. OPTIONAL, and nothing reads it: step.py never names it and `context_fields` does not select it, so the projection deletes it before the prompt. The handoff's State Interaction table still lists it and is stale. Surveyed by library/tools/input_contract.py."
      },
      {
        "name": "timeline_notes",
        "type": "object",
        "required": false,
        "description": "The captain's own notes typed onto the built timeline in DaVinci Resolve, routed to this step because this step owns the decision each note is about. Injected by the runner from <project>/marker_feedback/ and absent when there are none. See library/tools/marker_routing.py."
      }
    ],
    "outputs": [
      {
        "name": "cut_decisions",
        "type": "list"
      },
      {
        "name": "rough_cut_review",
        "type": "object",
        "description": "State output: rough_cut_review"
      }
    ],
    "preconditions": [
      "'a_roll_assignments' exists in state",
      "'b_roll_assignments' exists in state",
      "'b_roll_interjections' exists in state",
      "'audio_spine' exists in state",
      "'speech_sequence' exists in state",
      "'creative_direction' exists in state"
    ],
    "postconditions": [
      "'rough_cut_review' is written to state",
      "'rough_cut_review.passed' is true OR 'rough_cut_review.rejection_reasons' is non-empty"
    ]
  },
  "classification": {
    "stage": "edit",
    "determinism": "hybrid",
    "archetype": "evaluation_judgment",
    "idempotent": true
  },
  "dependencies": [
    "step_3_01_assign_aroll",
    "step_3_02_select_broll"
  ],
  "tags": [
    "evaluation_judgment",
    "video-editing",
    "quality_gate"
  ],
  "domain": "video-editing",
  "implementation": {
    "default": {
      "runtime": "hybrid",
      "entry_point": "handoff.md",
      "mechanical_checks": "step.py"
    },
    "variants": {},
    "test_entry_point": ""
  },
  "metadata": {
    "author": "prajwal",
    "created": "2026-07-25",
    "last_modified": "2026-07-25",
    "source_process": "video_editing_pipeline"
  },
  "context_fields": [
    "a_roll_assignments",
    "b_roll_assignments",
    "b_roll_interjections",
    "creative_direction",
    "render_qa_findings",
    "rough_cut_review",
    "audio_spine",
    "-audio_spine.structure.*.word_timestamps",
    "-audio_spine.structure.*.content.word_timestamps",
    "-audio_spine.music_selection.candidates_evaluated",
    "-audio_spine.music_selection.direction_justification.why_not_forbidden",
    "speech_sequence",
    "-speech_sequence.hook_segment.word_timestamps",
    "-speech_sequence.body_sequence.*.word_timestamps",
    "-speech_sequence.alignment_report"
  ]
}
