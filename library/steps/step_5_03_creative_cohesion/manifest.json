{
  "id": "step_5_03_creative_cohesion",
  "name": "Creative Cohesion Review",
  "version": "1.0.0",
  "description": "Reviews creative decisions across plans for cohesion and consistency.",
  "level": "step",
  "interface": {
    "inputs": [
      {
        "name": "creative_direction",
        "type": "object",
        "required": true,
        "description": "State input: creative_direction"
      },
      {
        "name": "speech_sequence",
        "type": "object",
        "required": false,
        "description": "State input: speech_sequence"
      },
      {
        "name": "transition_spec",
        "type": "object",
        "required": true,
        "description": "State input: transition_spec"
      },
      {
        "name": "enhancement_spec",
        "type": "object",
        "required": false,
        "description": "State input: enhancement_spec (VFX)"
      },
      {
        "name": "sfx_spec",
        "type": "object",
        "required": true,
        "description": "State input: sfx_spec"
      },
      {
        "name": "color_grade_spec",
        "type": "object",
        "required": true,
        "description": "State input: color_grade_spec"
      },
      {
        "name": "brand_template",
        "type": "object",
        "required": false,
        "description": "State input: brand_template"
      }
    ],
    "outputs": [
      {
        "name": "step",
        "type": "string",
        "description": "State output: step"
      },
      {
        "name": "cohesion_review",
        "type": "object",
        "description": "State output: cohesion_review"
      }
    ],
    "preconditions": [
      "'creative_direction' exists in state",
      "'transition_spec' exists in state",
      "'sfx_spec' exists in state",
      "'color_grade_spec' exists in state"
    ],
    "postconditions": [
      "'cohesion_review' is written to state"
    ]
  },
  "classification": {
    "determinism": "deterministic",
    "archetype": "data_transformation",
    "idempotent": true
  },
  "state": {
    "reads": [
      "creative_direction",
      "speech_sequence",
      "transition_spec",
      "enhancement_spec",
      "sfx_spec",
      "color_grade_spec",
      "brand_template"
    ],
    "writes": [
      "step",
      "cohesion_review"
    ]
  },
  "dependencies": [
    "step_2_01_creative_direction",
    "step_2_02_speech_sequence",
    "step_4_02_plan_transitions",
    "step_4_03_plan_vfx",
    "step_4_04_plan_sfx",
    "step_5_01_color_grade"
  ],
  "tags": [
    "creative",
    "cohesion",
    "deterministic"
  ],
  "domain": "video-editing",
  "implementation": {
    "default": {
      "runtime": "python",
      "entry_point": "step.py"
    }
  }
}
