{
  "id": "step_5_03_creative_cohesion",
  "name": "Creative Cohesion Review",
  "version": "1.0.0",
  "description": "Reviews creative decisions across plans for cohesion and consistency.",
  "level": "step",
  "interface": {
    "inputs": [
      {
        "name": "a_roll_assignments",
        "type": "array",
        "required": false,
        "description": "State input: a_roll_assignments (timeline fallback when the spine is absent)"
      },
      {
        "name": "audio_spine",
        "type": "object",
        "required": false,
        "description": "State input: audio_spine - the timeline the duration gate measures"
      },
      {
        "name": "creative_direction",
        "type": "object",
        "required": true,
        "description": "State input: creative_direction"
      },
      {
        "name": "enhancement_spec",
        "type": "object",
        "required": false,
        "description": "State input: enhancement_spec (VFX)"
      },
      {
        "name": "project_config",
        "type": "object",
        "required": false,
        "description": "State input: project_config - the project's own declarations. `get_target_duration_zone` reads target_duration_seconds off it; without one the duration gate says so rather than measuring."
      },
      {
        "name": "sfx_spec",
        "type": "object",
        "required": true,
        "description": "State input: sfx_spec"
      },
      {
        "name": "speech_sequence",
        "type": "object",
        "required": false,
        "description": "State input: speech_sequence"
      },
      {
        "name": "transition_spec",
        "type": "array",
        "required": true,
        "description": "State input: transition_spec"
      }
    ],
    "outputs": [
      {
        "name": "cohesion_review",
        "type": "object",
        "description": "State output: cohesion_review - warnings, the adjustments step_5_04 applies, and the observations a step upstream owns (library/tools/cohesion_scope.py)"
      },
      {
        "name": "step",
        "type": "string",
        "description": "State output: step"
      }
    ],
    "preconditions": [
      "'creative_direction' exists in state",
      "'transition_spec' exists in state",
      "'sfx_spec' exists in state"
    ],
    "postconditions": [
      "'cohesion_review' is written to state"
    ]
  },
  "classification": {
    "stage": "edit",
    "determinism": "deterministic",
    "archetype": "data_transformation",
    "idempotent": true
  },
  "dependencies": [
    "step_2_01_creative_direction",
    "step_2_05_mesh_spine",
    "step_3_01_assign_aroll",
    "step_2_02_speech_sequence",
    "step_4_02_plan_transitions",
    "step_4_03_plan_vfx",
    "step_4_04_plan_sfx"
  ],
  "tags": [
    "creative",
    "cohesion",
    "deterministic"
  ],
  "domain": "video-editing",
  "implementation": {
    "default": {
      "runtime": "python",
      "entry_point": "step.py"
    }
  }
}
