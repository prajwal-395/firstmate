{
  "id": "step_4_03_plan_vfx",
  "name": "Plan VFX",
  "version": "1.0.0",
  "description": "Plans visual effects enhancements for specific clips.",
  "level": "step",
  "interface": {
    "inputs": [
      {
        "name": "a_roll_assignments",
        "type": "array",
        "required": true,
        "description": "State input: a_roll_assignments"
      },
      {
        "name": "b_roll_assignments",
        "type": "array",
        "required": true,
        "description": "State input: b_roll_assignments"
      },
      {
        "name": "creative_direction",
        "type": "object",
        "required": true,
        "description": "State input: creative_direction"
      },
      {
        "name": "rough_cut_review",
        "type": "object",
        "required": true,
        "description": "State input: rough_cut_review"
      },
      {
        "name": "semantic_analysis_documents",
        "type": "array",
        "required": true,
        "description": "State input: semantic_analysis_documents"
      },
      {
        "name": "timed_spine",
        "type": "object",
        "required": true,
        "description": "State input: timed_spine"
      }
    ],
    "outputs": [
      {
        "name": "enhancement_spec",
        "type": "object",
        "description": "State output: enhancement_spec",
        "expected_schema": {
          "vfx_creative": "list"
        }
      },
      {
        "name": "vfx_candidates_toon",
        "type": "string",
        "description": "State output: vfx_candidates_toon"
      }
    ],
    "preconditions": [
      "'a_roll_assignments' exists in state",
      "'b_roll_assignments' exists in state",
      "'creative_direction' exists in state",
      "'semantic_analysis_documents' exists in state",
      "'rough_cut_review.passed' is true in state"
    ],
    "postconditions": [
      "'enhancement_spec' is written to state"
    ],
    "llm_outputs": [
      {
        "name": "vfx_creative",
        "type": "list",
        "required": true,
        "description": "Visual effects, at most one per block. Each: target_block_position, effect_type, intensity (subtle|moderate|strong), rationale"
      }
    ]
  },
  "classification": {
    "determinism": "hybrid",
    "archetype": "content_generation",
    "idempotent": false
  },
  "dependencies": [
    "step_3_01_assign_aroll",
    "step_3_02_select_broll",
    "step_3_03_review_rough_cut"
  ],
  "tags": [
    "content_generation",
    "video-editing",
    "nondeterministic"
  ],
  "domain": "video-editing",
  "implementation": {
    "default": {
      "runtime": "python",
      "entry_point": "bridge.py"
    },
    "variants": {},
    "test_entry_point": ""
  },
  "metadata": {
    "author": "prajwal",
    "created": "2026-07-20",
    "last_modified": "2026-07-20",
    "source_process": "video_editing_pipeline"
  },
  "context_fields": [
    "a_roll_assignments",
    "b_roll_assignments",
    "creative_direction",
    "rough_cut_review",
    "timed_spine",
    "semantic_analysis_documents.*.clip_id",
    "semantic_analysis_documents.*.analysis.scene",
    "semantic_analysis_documents.*.assessment.keywords"
  ]
}
