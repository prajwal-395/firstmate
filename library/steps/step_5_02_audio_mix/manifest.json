{
  "id": "step_5_02_audio_mix",
  "name": "Audio Mix",
  "version": "1.0.0",
  "description": "Balances and mixes audio streams for the final output.",
  "level": "step",
  "interface": {
    "inputs": [
      {
        "name": "audio_spine",
        "type": "object",
        "required": true,
        "description": "State input: audio_spine (the timed audio spine with structure and music_behavior)"
      },
      {
        "name": "enhancement_spec",
        "type": "object",
        "required": false,
        "description": "State input: enhancement_spec (VFX/enhancement data, used for audio-aware mixing)"
      },
      {
        "name": "music_selection",
        "type": "object",
        "required": true,
        "description": "State input: music_selection"
      },
      {
        "name": "creative_direction",
        "type": "object",
        "required": true,
        "description": "State input: creative_direction"
      }
    ],
    "outputs": [
      {
        "name": "audio_mix_spec",
        "type": "object",
        "description": "State output: audio_mix_spec"
      }
    ],
    "preconditions": [
      "'audio_spine' exists in state",
      "'music_selection' exists in state",
      "'creative_direction' exists in state"
    ],
    "postconditions": [
      "'audio_mix_spec' is written to state"
    ]
  },
  "classification": {
    "determinism": "deterministic",
    "archetype": "data_transformation",
    "idempotent": true
  },
  "state": {
    "reads": [
      "audio_spine",
      "creative_direction",
      "music_selection",
      "project_folder"
    ],
    "writes": [
      "audio_mix_spec"
    ]
  },
  "dependencies": [
