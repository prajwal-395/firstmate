{
  "id": "step_3_02_select_broll",
  "name": "Select B Roll",
  "version": "1.0.0",
  "description": "Selects B-roll clips based on A-roll assignments and semantic analysis.",
  "level": "step",
  "interface": {
    "inputs": [
      {
        "name": "a_roll_assignments",
        "type": "array",
        "required": true,
        "description": "State input: a_roll_assignments"
      },
      {
        "name": "clip_catalog",
        "type": "array",
        "required": true,
        "description": "State input: clip_catalog"
      },
      {
        "name": "creative_direction",
        "type": "object",
        "required": true,
        "description": "State input: creative_direction"
      },
      {
        "name": "semantic_analysis_documents",
        "type": "array",
        "required": true,
        "description": "State input: semantic_analysis_documents"
      },
      {
        "name": "temporal_event_indices",
        "type": "array",
        "required": true,
        "description": "State input: temporal_event_indices"
      },
      {
        "name": "timed_spine",
        "type": "object",
        "required": true,
        "description": "State input: timed_spine"
      },
      {
        "name": "creative_brief",
        "type": "string",
        "required": false,
        "description": "The captain's creative direction as markdown, injected by the runner from the project's creative_brief path. Empty when the project declares none."
      },
      {
        "name": "timeline_notes",
        "type": "object",
        "required": false,
        "description": "The captain's own notes typed onto the built timeline in DaVinci Resolve, routed to this step because this step owns the decision each note is about. Injected by the runner from <project>/marker_feedback/ and absent when there are none. See library/tools/marker_routing.py."
      }
    ],
    "outputs": [
      {
        "name": "b_roll_assignments",
        "type": "array",
        "description": "State output: b_roll_assignments",
        "expected_schema": "resolve_manifest.py"
      },
      {
        "name": "b_roll_interjections",
        "type": "array",
        "description": "State output: b_roll_interjections",
        "expected_schema": "resolve_manifest.py"
      },
      {
        "name": "broll_candidates_toon",
        "type": "string",
        "description": "State output: broll_candidates_toon",
        "expected_schema": {
          "broll_creative": "list",
          "b_roll_interjections": "list"
        }
      },
      {
        "name": "broll_window_frames",
        "type": "string",
        "description": "A map of the frame strips the pre-bridge drew, one per candidate cutaway window, with the directory holding them. Prompt-only: it shows the model what a window LOOKS like beside the prose that says what it does. See library/tools/window_frames.py."
      }
    ],
    "preconditions": [
      "'a_roll_assignments' exists in state",
      "'semantic_analysis_documents' exists in state",
      "'creative_direction' exists in state",
      "'timed_spine' exists in state",
      "'temporal_event_indices' exists in state",
      "'clip_catalog' exists in state"
    ],
    "postconditions": [
      "'b_roll_assignments' is written to state"
    ],
    "llm_outputs": [
      {
        "name": "broll_creative",
        "type": "list",
        "required": true,
        "description": "B-roll selections. Each: clip_id (from broll_candidates_toon), spine_block_position, preferred_moment, selection_rationale. NEVER select the clip the block's A-roll already shows"
      },
      {
        "name": "b_roll_interjections",
        "type": "list",
        "required": false,
        "description": "Standalone cutaways. Each: clip_id, over_spine_block_position, timeline_start, timeline_end, purpose"
      }
    ]
  },
  "classification": {
    "stage": "edit",
    "determinism": "hybrid",
    "archetype": "evaluation_judgment",
    "idempotent": false
  },
  "dependencies": [
    "step_3_01_assign_aroll"
  ],
  "tags": [
    "evaluation_judgment",
    "video-editing",
    "nondeterministic"
  ],
  "domain": "video-editing",
  "implementation": {
    "default": {
      "runtime": "python",
      "entry_point": "bridge.py"
    },
    "variants": {},
    "test_entry_point": ""
  },
  "metadata": {
    "author": "prajwal",
    "created": "2026-07-20",
    "last_modified": "2026-07-20",
    "source_process": "video_editing_pipeline"
  },
  "context_fields": [
    "broll_candidates_toon",
    "broll_window_frames",
    "a_roll_assignments",
    "creative_direction",
    "timed_spine",
    "-timed_spine.structure.*.word_timestamps",
    "-timed_spine.structure.*.content.word_timestamps",
    "clip_catalog.*.clip_id",
    "clip_catalog.*.filename",
    "clip_catalog.*.duration_seconds",
    "clip_catalog.*.width",
    "clip_catalog.*.height",
    "clip_catalog.*.rotation",
    "clip_catalog.*.frame_rate",
    "semantic_analysis_documents.*.clip_id",
    "semantic_analysis_documents.*.duration_s",
    "semantic_analysis_documents.*.assessment.interest_score",
    "semantic_analysis_documents.*.assessment.keywords",
    "semantic_analysis_documents.*.assessment.clip_type",
    "semantic_analysis_documents.*.scene",
    "semantic_analysis_documents.*.camera",
    "semantic_analysis_documents.*.objects",
    "semantic_analysis_documents.*.assessment.content_type",
    "semantic_analysis_documents.*.assessment.camera_stability",
    "semantic_analysis_documents.*.assessment.usable_ranges",
    "semantic_analysis_documents.*.assessment.usable_ranges_method",
    "semantic_analysis_documents.*.assessment.primary_subject_visible",
    "temporal_event_indices.*.clip_id",
    "view:picture"
  ]
}
