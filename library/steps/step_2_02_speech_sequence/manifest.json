{
  "id": "step_2_02_speech_sequence",
  "name": "Speech Sequence",
  "version": "1.0.0",
  "description": "Generates the main speech sequence guided by creative direction.",
  "level": "step",
  "interface": {
    "inputs": [
      {
        "name": "creative_brief",
        "type": "string",
        "required": false,
        "description": "The captain's creative direction as markdown, injected by the runner from the project's creative_brief path. Empty when the project declares none."
      },
      {
        "name": "creative_direction",
        "type": "object",
        "required": true,
        "description": "State input: creative_direction"
      },
      {
        "name": "project_config",
        "type": "object",
        "required": false,
        "description": "State input: project_config - the project's own declarations, read from project.yaml by load_pipeline_state and broadcast by the runner. The handoff asks the model to read target_duration_seconds from it."
      },
      {
        "name": "semantic_analysis_documents",
        "type": "array",
        "required": true,
        "description": "State input: semantic_analysis_documents"
      },
      {
        "name": "temporal_index",
        "type": "array",
        "required": true,
        "description": "State input: temporal_index"
      }
    ],
    "outputs": [
      {
        "name": "speech_sequence",
        "type": "object",
        "description": "State output: speech_sequence",
        "expected_schema": {
          "hook_segment": "object",
          "body_sequence": "list",
          "excluded_passages": "list"
        }
      },
      {
        "name": "topics_toon",
        "type": "string",
        "description": "State output: topics_toon"
      },
      {
        "name": "transcripts_toon",
        "type": "string",
        "description": "State output: transcripts_toon"
      }
    ],
    "preconditions": [
      "'temporal_index' exists in state",
      "'creative_direction' exists in state",
      "'semantic_analysis_documents' exists in state"
    ],
    "postconditions": [
      "'speech_sequence' is written to state"
    ]
  },
  "classification": {
    "stage": "edit",
    "determinism": "hybrid",
    "archetype": "content_generation",
    "idempotent": false
  },
  "dependencies": [
    "step_1_04_temporal_index",
    "step_2_01_creative_direction"
  ],
  "tags": [
    "content_generation",
    "video-editing",
    "nondeterministic"
  ],
  "domain": "video-editing",
  "implementation": {
    "default": {
      "runtime": "llm",
      "entry_point": "handoff.md"
    },
    "variants": {},
    "test_entry_point": ""
  },
  "metadata": {
    "author": "prajwal",
    "created": "2026-07-20",
    "last_modified": "2026-07-20",
    "source_process": "video_editing_pipeline"
  },
  "context_fields": [
    "creative_direction",
    "project_config",
    "semantic_analysis_documents.*.clip_id",
    "semantic_analysis_documents.*.blocks",
    "semantic_analysis_documents.*.duration_s",
    "semantic_analysis_documents.*.analysis.scene",
    "semantic_analysis_documents.*.analysis.motion",
    "semantic_analysis_documents.*.analysis.emotion",
    "semantic_analysis_documents.*.analysis.energy",
    "semantic_analysis_documents.*.assessment.interest_score",
    "semantic_analysis_documents.*.assessment.moment_type",
    "semantic_analysis_documents.*.assessment.keywords",
    "semantic_analysis_documents.*.assessment.usable_portions",
    "semantic_analysis_documents.*.assessment.content_type",
    "semantic_analysis_documents.*.assessment.speech_coverage",
    "semantic_analysis_documents.*.assessment.usable_ranges",
    "semantic_analysis_documents.*.assessment.unusable_ranges",
    "temporal_index.*.clip_id"
  ]
}
