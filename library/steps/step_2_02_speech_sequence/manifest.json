{
  "id": "step_2_02_speech_sequence",
  "name": "Speech Sequence",
  "version": "1.0.0",
  "description": "Generates the main speech sequence guided by creative direction.",
  "level": "step",
  "interface": {
    "inputs": [
      {
        "name": "temporal_index",
        "type": "array",
        "required": true,
        "description": "State input: temporal_index"
      },
      {
        "name": "creative_direction",
        "type": "object",
        "required": true,
        "description": "State input: creative_direction"
      },
      {
        "name": "semantic_analysis_documents",
        "type": "array",
        "required": true,
        "description": "State input: semantic_analysis_documents"
      },
      {
        "name": "creative_brief",
        "type": "string",
        "required": false,
        "description": "Markdown creative brief document from the project (injected from creative_brief_path in project config)"
      }
    ],
    "outputs": [
      {
        "name": "transcripts_toon",
        "type": "string",
        "description": "State output: transcripts_toon"
      },
      {
        "name": "topics_toon",
        "type": "string",
        "description": "State output: topics_toon"
      },
      {
        "name": "speech_sequence",
        "type": "object",
        "description": "State output: speech_sequence",
        "expected_schema": {
          "hook_segment": "object",
          "body_sequence": "list",
          "excluded_passages": "list"
        }
      }
    ],
    "preconditions": [
      "'temporal_index' exists in state",
      "'creative_direction' exists in state",
      "'semantic_analysis_documents' exists in state"
    ],
    "postconditions": [
      "'speech_sequence' is written to state"
    ]
  },
  "classification": {
    "determinism": "hybrid",
    "archetype": "content_generation",
    "idempotent": false
  },
  "state": {
    "reads": [
      "creative_brief",
      "creative_direction",
      "project_folder",
      "temporal_index"
    ],
    "writes": [
      "transcripts_toon",
      "topics_toon",
      "speech_sequence"
    ]
  },
  "dependencies": [
    "step_1_04_temporal_index",
    "step_2_01_creative_direction"
  ],
  "tags": [
    "content_generation",
    "video-editing",
    "nondeterministic"
  ],
  "domain": "video-editing",
  "implementation": {
    "default": {
      "runtime": "llm",
      "entry_point": "handoff.md"
    },
    "variants": {},
    "test_entry_point": ""
  },
  "metadata": {
    "author": "prajwal",
    "created": "2026-07-20",
    "last_modified": "2026-07-20",
    "source_process": "video_editing_pipeline"
  },
  "context_fields": [
    "creative_direction",
    "semantic_analysis_documents.*.summary",
    "semantic_analysis_documents.*.scene_segments.*.interest_score",
    "semantic_analysis_documents.*.scene_segments.*.tags",
    "temporal_index.*.speech_regions",
    "temporal_index.*.scene_boundaries",
    "clip_catalog.*.filename",
    "clip_catalog.*.duration_seconds"
  ]
}
