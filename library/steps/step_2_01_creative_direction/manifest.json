{
  "id": "step_2_01_creative_direction",
  "name": "Creative Direction",
  "version": "1.0.0",
  "description": "Establishes the overall creative direction based on semantic analysis and temporal indexing.",
  "level": "step",
  "interface": {
    "inputs": [
      {
        "name": "clip_catalog",
        "type": "array",
        "required": true,
        "description": "State input: clip_catalog"
      },
      {
        "name": "semantic_analysis_documents",
        "type": "array",
        "required": true,
        "description": "State input: semantic_analysis_documents"
      },
      {
        "name": "temporal_index",
        "type": "array",
        "required": true,
        "description": "State input: temporal_index"
      },
      {
        "name": "creative_brief",
        "type": "string",
        "required": false,
        "description": "The captain's creative direction as markdown, injected by the runner from the project's creative_brief path. Empty when the project declares none."
      },
      {
        "name": "timeline_notes",
        "type": "object",
        "required": false,
        "description": "The captain's own notes typed onto the built timeline in DaVinci Resolve, routed to this step because this step owns the decision each note is about. Injected by the runner from <project>/marker_feedback/ and absent when there are none. See library/tools/marker_routing.py."
      }
    ],
    "outputs": [
      {
        "name": "creative_direction",
        "type": "object",
        "description": "State output: creative_direction",
        "expected_schema": {
          "narrative_theme": "string",
          "target_mood": "string",
          "target_energy": "string",
          "energy_arc": "string",
          "emotional_landscape": "string",
          "audience_emotion": "string",
          "key_moments": "list",
          "rationale": "string"
        }
      }
    ],
    "preconditions": [
      "'semantic_analysis_documents' exists in state",
      "'temporal_index' exists in state",
      "'clip_catalog' exists in state"
    ],
    "postconditions": [
      "'creative_direction' is written to state"
    ]
  },
  "classification": {
    "stage": "edit",
    "determinism": "nondeterministic",
    "archetype": "evaluation_judgment",
    "idempotent": false
  },
  "dependencies": [
    "step_1_03_semantic_analysis",
    "step_1_04_temporal_index"
  ],
  "tags": [
    "evaluation_judgment",
    "video-editing",
    "nondeterministic"
  ],
  "domain": "video-editing",
  "implementation": {
    "default": {
      "runtime": "llm",
      "entry_point": "handoff.md"
    },
    "variants": {},
    "test_entry_point": ""
  },
  "metadata": {
    "author": "prajwal",
    "created": "2026-07-20",
    "last_modified": "2026-07-20",
    "source_process": "video_editing_pipeline"
  },
  "context_fields": [
    "semantic_analysis_documents.*.clip_id",
    "semantic_analysis_documents.*.duration_s",
    "semantic_analysis_documents.*.analysis.scene",
    "semantic_analysis_documents.*.analysis.motion",
    "semantic_analysis_documents.*.analysis.mood",
    "semantic_analysis_documents.*.analysis.energy",
    "semantic_analysis_documents.*.analysis.emotion",
    "semantic_analysis_documents.*.assessment.moment_type",
    "semantic_analysis_documents.*.assessment.keywords",
    "semantic_analysis_documents.*.assessment.content_type",
    "semantic_analysis_documents.*.assessment.usable_ranges",
    "semantic_analysis_documents.*.assessment.usable_ranges_method",
    "view:picture",
    "view:transcript",
