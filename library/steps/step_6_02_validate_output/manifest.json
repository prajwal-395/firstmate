{
  "id": "step_6_02_validate_output",
  "name": "Validate Output",
  "version": "1.0.0",
  "description": "Validates the rendered output against the assembly manifest.",
  "level": "step",
  "interface": {
    "inputs": [
      {
        "name": "assembly_manifest",
        "type": "object",
        "required": true,
        "description": "State input: assembly_manifest"
      },
      {
        "name": "rendered_output",
        "type": "object",
        "required": true,
        "description": "State input: rendered_output"
      },
      {
        "name": "project_folder",
        "type": "string",
        "required": false,
        "description": "The project this run belongs to. Declared so the QA report lands in the project's exports area by name rather than beside whatever path the render reported. See library/tools/project_layout.py."
      }
    ],
    "outputs": [
      {
        "name": "final_qa_decision",
        "type": "string"
      },
      {
        "name": "validation_result",
        "type": "object",
        "description": "State output: validation_result"
      }
    ],
    "preconditions": [
      "'rendered_output' exists in state",
      "'assembly_manifest' exists in state"
    ],
    "postconditions": [
      "'validation_result' is written to state"
    ]
  },
  "classification": {
    "stage": "edit",
    "determinism": "nondeterministic",
    "archetype": "evaluation_judgment",
    "idempotent": false
  },
  "dependencies": [
    "step_6_01_render"
  ],
  "tags": [
    "evaluation_judgment",
    "video-editing",
    "nondeterministic"
  ],
  "domain": "video-editing",
  "implementation": {
    "default": {
      "runtime": "python",
      "entry_point": "step.py"
    },
    "variants": {
      "llm_review": {
        "runtime": "llm",
        "entry_point": "handoff.md"
      }
    },
    "test_entry_point": ""
  },
  "metadata": {
    "author": "prajwal",
    "created": "2026-07-20",
    "last_modified": "2026-07-20",
    "source_process": "video_editing_pipeline"
  }
}
