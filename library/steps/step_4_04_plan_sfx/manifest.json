{
  "id": "step_4_04_plan_sfx",
  "name": "Plan SFX",
  "version": "1.0.0",
  "description": "Plans sound effects timing based on the timed spine and visual events.",
  "level": "step",
  "interface": {
    "inputs": [
      {
        "name": "b_roll_assignments",
        "type": "array",
        "required": true,
        "description": "State input: b_roll_assignments"
      },
      {
        "name": "creative_direction",
        "type": "object",
        "required": true,
        "description": "State input: creative_direction"
      },
      {
        "name": "music_analysis",
        "type": "object",
        "required": true,
        "description": "State input: music_analysis"
      },
      {
        "name": "rough_cut_review",
        "type": "object",
        "required": true,
        "description": "State input: rough_cut_review"
      },
      {
        "name": "semantic_analysis_documents",
        "type": "array",
        "required": true,
        "description": "State input: semantic_analysis_documents"
      },
      {
        "name": "temporal_event_indices",
        "type": "array",
        "required": true,
        "description": "State input: temporal_event_indices"
      },
      {
        "name": "timed_spine",
        "type": "object",
        "required": true,
        "description": "State input: timed_spine"
      },
      {
        "name": "creative_brief",
        "type": "string",
        "required": false,
        "description": "The captain's creative direction as markdown, injected by the runner from the project's creative_brief path. Empty when the project declares none."
      },
      {
        "name": "project_fps",
        "type": "number",
        "required": true,
        "description": "Timebase from the catalog. Every consumer used to read its own 30.0 default because no edge carried it."
      }
    ],
    "outputs": [
      {
        "name": "available_sfx_types",
        "type": "array",
        "required": true,
        "description": "Bridge output: the sound types the SFX library can actually play. Declared here because the bridge emits it on every run and validate_step_output otherwise reports it as an unexpected extra field on every run - a warning that fires on correct output."
      },
      {
        "name": "sfx_candidates_toon",
        "type": "string",
        "description": "State output: sfx_candidates_toon"
      },
      {
        "name": "sfx_spec",
        "type": "object",
        "description": "State output: sfx_spec",
        "expected_schema": {
          "sfx_creative": "list"
        }
      }
    ],
    "preconditions": [
      "'timed_spine' exists in state",
      "'creative_direction' exists in state",
      "'semantic_analysis_documents' exists in state",
      "'rough_cut_review.passed' is true in state"
    ],
    "postconditions": [
      "'sfx_spec' is written to state"
    ],
    "llm_outputs": [
      {
        "name": "sfx_creative",
        "type": "list",
        "required": true,
        "description": "Sound effects at DISTINCT positions - as many as the piece earns, with no minimum and no maximum. Each: spine_block_position, sfx_type (whoosh|swish|bass_impact|riser|click|tick|reverse_cymbal|swell), volume_level, rationale"
      }
    ]
  },
  "classification": {
    "stage": "edit",
    "determinism": "hybrid",
    "archetype": "content_generation",
    "idempotent": false
  },
  "dependencies": [
    "step_2_05_mesh_spine",
    "step_3_03_review_rough_cut"
  ],
  "tags": [
    "content_generation",
    "video-editing",
    "nondeterministic"
  ],
  "domain": "video-editing",
  "implementation": {
    "default": {
      "runtime": "python",
      "entry_point": "bridge.py"
    },
    "variants": {},
    "test_entry_point": ""
  },
  "metadata": {
    "author": "prajwal",
    "created": "2026-07-20",
    "last_modified": "2026-07-20",
    "source_process": "video_editing_pipeline"
  },
  "context_fields": [
    "available_sfx_types",
    "b_roll_assignments",
    "creative_direction",
    "rough_cut_review",
    "timed_spine",
    "-timed_spine.structure.*.word_timestamps",
    "-timed_spine.structure.*.content.word_timestamps",
    "music_analysis",
    "-music_analysis.tempo.beats",
    "-music_analysis.tempo.downbeats",
    "-music_analysis.energy_dynamics.energy_curve_1hz",
    "semantic_analysis_documents.*.clip_id",
    "semantic_analysis_documents.*.analysis.scene",
    "semantic_analysis_documents.*.analysis.audio_prediction",
    "semantic_analysis_documents.*.assessment.keywords",
    "semantic_analysis_documents.*.assessment.content_type",
    "temporal_event_indices.*.clip_id"
  ]
}
