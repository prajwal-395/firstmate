{
  "id": "step_6_01_render",
  "name": "Render",
  "version": "1.0.0",
  "description": "Executes the DaVinci Resolve orchestrator to render the final video.",
  "level": "step",
  "interface": {
    "inputs": [
      {
        "name": "assembly_manifest",
        "type": "object",
        "required": true,
        "description": "State input: assembly_manifest"
      },
      {
        "name": "timeline_notes",
        "type": "object",
        "required": false,
        "description": "The captain's own notes typed onto the built timeline in DaVinci Resolve, routed to this step because this step owns the decision each note is about. Injected by the runner from <project>/marker_feedback/ and absent when there are none. See library/tools/marker_routing.py."
      }
    ],
    "outputs": [
      {
        "name": "render_output",
        "type": "object",
        "description": "State output: render_output"
      },
      {
        "name": "render_review",
        "type": "array",
        "required": false,
        "description": "Visual QA verdicts"
      }
    ],
    "preconditions": [
      "'assembly_manifest' exists in state"
    ],
    "postconditions": [
      "'render_output' is written to state"
    ]
  },
  "classification": {
    "stage": "edit",
    "determinism": "nondeterministic",
    "archetype": "direct_action",
    "idempotent": true
  },
  "dependencies": [
    "step_5_04_compile_manifest"
  ],
  "tags": [
    "direct_action",
    "video-editing",
    "deterministic"
  ],
  "domain": "video-editing",
  "implementation": {
    "default": {
      "runtime": "python",
      "entry_point": "resolve_build_timeline.py"
    },
    "variants": {},
    "test_entry_point": ""
  },
  "metadata": {
    "author": "prajwal",
    "created": "2026-07-20",
    "last_modified": "2026-07-20",
    "source_process": "video_editing_pipeline"
  },
  "context_fields": [
    "-assembly_manifest.subtitles.*.words"
  ]
}
