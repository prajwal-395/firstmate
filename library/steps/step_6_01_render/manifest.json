{
  "id": "step_6_01_render",
  "name": "Render",
  "version": "1.0.0",
  "description": "Executes the DaVinci Resolve orchestrator to render the final video.",
  "level": "step",
  "interface": {
    "inputs": [
      {
        "name": "assembly_manifest",
        "type": "object",
        "required": true,
        "description": "State input: assembly_manifest"
      }
    ],
    "outputs": [
      {
        "name": "render_output",
        "type": "object",
        "description": "State output: render_output"
      },
      {
        "name": "visual_qa",
        "type": "array",
        "required": false,
        "description": "Visual QA verdicts"
      }
    ],
    "preconditions": [
      "'assembly_manifest' exists in state"
    ],
    "postconditions": [
      "'render_output' is written to state"
    ]
  },
  "classification": {
    "determinism": "nondeterministic",
    "archetype": "direct_action",
    "idempotent": true
  },
  "state": {
    "reads": [
      "assembly_manifest",
      "project_folder"
    ],
    "writes": [
      "render_output",
      "visual_qa"
    ]
  },
  "dependencies": [
