  ],
  "tags": [
    "direct_action",
    "video-editing",
    "deterministic"
  ],
  "domain": "video-editing",
  "implementation": {
    "default": {
      "runtime": "python",
      "entry_point": "resolve_build_timeline.py"
    },
    "variants": {},
    "test_entry_point": ""
  },
  "metadata": {
    "author": "prajwal",
