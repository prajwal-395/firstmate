{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ren.video/schemas/model-registry.schema.json",
  "title": "Ren model implementation registry",
  "type": "object",
  "required": ["schema_version", "capabilities", "implementations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "capabilities": {
      "type": "array",
      "items": {"$ref": "#/$defs/capability"},
      "uniqueItems": true
    },
    "implementations": {
      "type": "array",
      "items": {"$ref": "#/$defs/implementation"},
      "uniqueItems": true
    }
  },
  "$defs": {
    "output_reuse": {
      "type": "object", "additionalProperties": false,
      "required": ["class", "permitted_editions", "reuse_scope", "license_evidence_ref", "review_required", "review_note"],
      "properties": {
        "class": {"enum": ["commercial", "personal_noncommercial", "research_only", "unknown"]},
        "permitted_editions": {"type": "array", "items": {"enum": ["commercial", "personal"]}, "uniqueItems": true},
        "reuse_scope": {"enum": ["any_edition", "personal_edition", "benchmark_only"]},
        "license_evidence_ref": {"type": "string", "minLength": 1},
        "review_required": {"type": "boolean"},
        "review_note": {"type": ["string", "null"]}
      }
    },
    "capability": {
      "type": "object", "required": ["id", "description"], "additionalProperties": false,
      "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}, "description": {"type": "string", "minLength": 1}}
    },
    "license_evidence": {
      "type": "object", "required": ["upstream_url", "exact_version", "retrieved_at", "license", "obligations", "approval_status"], "additionalProperties": false,
      "properties": {
        "upstream_url": {"type": ["string", "null"], "format": "uri"},
        "exact_version": {"type": ["string", "null"]},
        "retrieved_at": {"type": ["string", "null"], "format": "date"},
        "license": {"type": ["string", "null"]},
        "obligations": {"type": "array", "items": {"type": "string"}},
        "approval_status": {"enum": ["approved", "conditional", "unresolved", "rejected"]},
        "evidence_source": {"type": ["string", "null"]},
        "primary_evidence": {"type": ["object", "null"]}
      }
    },
    "implementation": {
      "type": "object",
      "required": ["id", "component_id", "label", "capabilities", "checkpoint", "license_evidence", "purposes", "editions", "qualification", "output_reuse"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "component_id": {"type": "string"}, "label": {"type": "string"},
        "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "checkpoint": {
          "type": "object", "required": ["version", "weights_hash", "provider", "conversion", "runtime"], "additionalProperties": false,
          "properties": {"version": {"type": ["string", "null"]}, "weights_hash": {"type": ["string", "null"]}, "provider": {"type": ["string", "null"]}, "conversion": {"type": ["string", "null"]}, "runtime": {"type": ["string", "null"]}}
        },
        "license_evidence": {"$ref": "#/$defs/license_evidence"},
        "purposes": {"type": "array", "items": {"enum": ["commercial_client", "personal_noncommercial", "permitted_research"]}, "uniqueItems": true},
        "editions": {"type": "array", "items": {"enum": ["commercial", "personal"]}, "uniqueItems": true},
        "qualification": {"enum": ["qualified", "unqualified", "unknown"]},
        "qualification_metrics": {"type": "object", "properties": {"quality": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "latency_cold_seconds": {"type": ["number", "null"], "minimum": 0}, "latency_warm_seconds": {"type": ["number", "null"], "minimum": 0}, "peak_memory_gb": {"type": ["number", "null"], "minimum": 0}}, "additionalProperties": false},
        "resources": {"type": "object", "properties": {"runtime_seconds": {"type": ["number", "null"], "minimum": 0}, "memory_gb": {"type": ["number", "null"], "minimum": 0}, "resident_memory_gb": {"type": ["number", "null"], "minimum": 0}}, "additionalProperties": false},
        "hardware": {"type": "object", "properties": {"accelerators": {"type": "array", "items": {"enum": ["ane", "gpu", "cpu"]}}}, "additionalProperties": false},
        "optional_download": {"type": "boolean"},
        "output_reuse": {"$ref": "#/$defs/output_reuse"},
        "runtime_env": {"$ref": "#/$defs/runtime_env"},
        "user_license": {"$ref": "#/$defs/user_license"}
      }
    },
    "runtime_env": {
      "type": "object", "required": ["name", "isolated"], "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "isolated": {"type": "boolean"},
        "requirements": {"type": ["string", "null"]},
        "python": {"type": ["string", "null"]}
      }
    },
    "user_license": {
      "type": ["object", "null"], "required": ["license_name", "entitlement_env"], "additionalProperties": false,
      "properties": {
        "license_name": {"type": "string", "minLength": 1},
        "entitlement_env": {"type": "string", "minLength": 1}
      }
    }
  }
}
