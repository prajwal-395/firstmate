{
	Tools = ordered() {
		IntroLowerThird = MacroOperator {
			Inputs = ordered() {
				Input1 = InstanceInput {
					SourceOp = "Text1",
					Source = "StyledText",
					Name = "TitleText",
				},
				Input2 = InstanceInput {
					SourceOp = "Background1",
					Source = "TopLeftRed",
					Name = "BrandColorR",
					ControlGroup = 2,
				},
				Input3 = InstanceInput {
					SourceOp = "Background1",
					Source = "TopLeftGreen",
					Name = "BrandColorG",
					ControlGroup = 2,
				},
				Input4 = InstanceInput {
					SourceOp = "Background1",
					Source = "TopLeftBlue",
					Name = "BrandColorB",
					ControlGroup = 2,
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "Merge1",
					Source = "Output",
				}
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Background1 = Background {
					Inputs = {
						Width = Input { Value = 1080, },
						Height = Input { Value = 1920, },
						TopLeftRed = Input { Value = 1.0, },
						TopLeftGreen = Input { Value = 0.0, },
						TopLeftBlue = Input { Value = 0.0, },
						GlobalOut = Input { Value = 100, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				Text1 = TextPlus {
					Inputs = {
						StyledText = Input { Value = "Series Title", },
						Font = Input { Value = "Helvetica", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.05, },
						Center = Input { Value = { 0.5, 0.2 }, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				Merge1 = Merge {
					Inputs = {
						Background = Input {
							SourceOp = "Background1",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Text1",
							Source = "Output",
						},
						Blend = Input { Value = 1.0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
			}
		}
	}
}