{
  "$defs": {
    "Animation": {
      "description": "One renderer-neutral animation.\n\n``target`` is the node id. ``property`` is a dot-separated path into\nthe node's state (``opacity``, ``transform.scale``, ``color``,\n``transform.translate``, ``blur``, ``clip``, ``width``, ``height``,\n``shader.<uniform>``, ``camera.<parameter>``). ``start`` and\n``duration`` are seconds on the scene clock.",
      "properties": {
        "target": {
          "title": "Target",
          "type": "string"
        },
        "property": {
          "title": "Property",
          "type": "string"
        },
        "from_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "string"
            }
          ],
          "title": "From Value"
        },
        "to_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "string"
            }
          ],
          "title": "To Value"
        },
        "start": {
          "title": "Start",
          "type": "number"
        },
        "duration": {
          "title": "Duration",
          "type": "number"
        },
        "easing": {
          "anyOf": [
            {
              "$ref": "#/$defs/LinearEasing"
            },
            {
              "$ref": "#/$defs/EaseEasing"
            },
            {
              "$ref": "#/$defs/CubicBezierEasing"
            },
            {
              "$ref": "#/$defs/SpringEasing"
            },
            {
              "$ref": "#/$defs/StepsEasing"
            }
          ],
          "title": "Easing"
        }
      },
      "required": [
        "target",
        "property",
        "from_value",
        "to_value",
        "start",
        "duration",
        "easing"
      ],
      "title": "Animation",
      "type": "object"
    },
    "AudioContent": {
      "description": "The content of an Audio reference node.",
      "properties": {
        "src": {
          "title": "Src",
          "type": "string"
        },
        "start": {
          "default": 0.0,
          "title": "Start",
          "type": "number"
        },
        "duration": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration"
        }
      },
      "required": [
        "src"
      ],
      "title": "AudioContent",
      "type": "object"
    },
    "BlurFilter": {
      "description": "A CSS ``blur()``.\n\n``sigma`` equals the CSS radius - measured against Chrome, not\nhalved. Maps 1:1 to CSS ``filter: blur()`` and SVG ``feGaussianBlur``.",
      "properties": {
        "kind": {
          "const": "blur",
          "title": "Kind",
          "type": "string"
        },
        "sigma": {
          "title": "Sigma",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "sigma"
      ],
      "title": "BlurFilter",
      "type": "object"
    },
    "Bounds": {
      "description": "A node's bounding box in delivery-frame pixels.",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "width": {
          "title": "Width",
          "type": "number"
        },
        "height": {
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Bounds",
      "type": "object"
    },
    "CameraContent": {
      "description": "The camera over the world: ``scale rotate translate`` about the frame\ncentre, and ``focus`` as a blur on the world group.\n\nMaps 1:1 to a CSS transform on the world element plus a ``blur()``\nfilter, and to an SVG group transform plus ``feGaussianBlur``.",
      "properties": {
        "scale": {
          "default": 1.0,
          "title": "Scale",
          "type": "number"
        },
        "rotate": {
          "default": 0.0,
          "title": "Rotate",
          "type": "number"
        },
        "translate": {
          "items": {
            "type": "number"
          },
          "title": "Translate",
          "type": "array"
        },
        "focus": {
          "default": 0.0,
          "title": "Focus",
          "type": "number"
        }
      },
      "title": "CameraContent",
      "type": "object"
    },
    "CubicBezierEasing": {
      "description": "A cubic bezier easing, the CSS ``cubic-bezier()`` function.",
      "properties": {
        "kind": {
          "const": "cubic_bezier",
          "default": "cubic_bezier",
          "title": "Kind",
          "type": "string"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        },
        "x2": {
          "title": "X2",
          "type": "number"
        },
        "y2": {
          "title": "Y2",
          "type": "number"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "CubicBezierEasing",
      "type": "object"
    },
    "DropShadowFilter": {
      "description": "A CSS ``drop-shadow()``.\n\n``sigma`` equals the CSS blur radius (measured: 1.0x, not b/2).\nMaps 1:1 to CSS ``filter: drop-shadow()`` and SVG ``feDropShadow``.\n\n``box-shadow`` is a different source function with a different\nmapping: its blur radius draws like HALF the ``drop-shadow()`` blur\nof the same number (measured on the review card's falloff), so a\nlowering quoting a ``box-shadow`` halves the radius before emitting\nthis filter. The halving lives in the lowering, not here, because\nthis filter's own source function maps 1:1.",
      "properties": {
        "kind": {
          "const": "drop_shadow",
          "title": "Kind",
          "type": "string"
        },
        "dx": {
          "title": "Dx",
          "type": "number"
        },
        "dy": {
          "title": "Dy",
          "type": "number"
        },
        "sigma": {
          "title": "Sigma",
          "type": "number"
        },
        "color": {
          "title": "Color",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "dx",
        "dy",
        "sigma",
        "color"
      ],
      "title": "DropShadowFilter",
      "type": "object"
    },
    "EaseEasing": {
      "description": "Power ease-out: ``1 - (1 - t) ** power``.\n\n``power=1`` is linear. ``power=3`` is the cubic out\nthe word-cue rise draws (GSAP ``power2.out``). The subtitle entry\nscale does NOT use this kind: the template draws Remotion\n``Easing.out(Easing.ease)``, which the lowering carries as a\n``CubicBezierEasing`` (``cubic-bezier(0, 0, 0.58, 1)``) - a power\nease-out sits ~0.06 off mid-ramp.",
      "properties": {
        "kind": {
          "const": "ease",
          "default": "ease",
          "title": "Kind",
          "type": "string"
        },
        "power": {
          "default": 2.0,
          "title": "Power",
          "type": "number"
        }
      },
      "title": "EaseEasing",
      "type": "object"
    },
    "EffectContent": {
      "description": "The content of an Effect node.",
      "properties": {
        "effect": {
          "title": "Effect",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "effect"
      ],
      "title": "EffectContent",
      "type": "object"
    },
    "FilterContent": {
      "description": "The content of a Filter node.",
      "properties": {
        "filter": {
          "title": "Filter",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        }
      },
      "required": [
        "filter"
      ],
      "title": "FilterContent",
      "type": "object"
    },
    "HTMLContent": {
      "description": "A node only the browser draws: an HTML/CSS layer.\n\n``engine`` is ``\"browser\"`` - the escape hatch for content FFrames'\nSVG has no answer for (arbitrary HTML, emoji). The\nbrowser adapters draw it as an HTML layer; FFrames refuses it by name\nrather than approximating it.",
      "properties": {
        "engine": {
          "default": "browser",
          "title": "Engine",
          "type": "string"
        },
        "html": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Html"
        }
      },
      "title": "HTMLContent",
      "type": "object"
    },
    "ImageContent": {
      "description": "The content of an Image node. ``src`` is a file path or data URI.\n\nThe image is contained in the node's bounds, centred, aspect kept\n(CSS ``object-fit: contain``).",
      "properties": {
        "src": {
          "title": "Src",
          "type": "string"
        },
        "alt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt"
        }
      },
      "required": [
        "src"
      ],
      "title": "ImageContent",
      "type": "object"
    },
    "Keyframe": {
      "description": "One key of a track.\n\n``ease`` names the segment ENDING at this key, the way StagedScene's\nkeyframes do; the first key's ease is never read. Absent means linear.",
      "properties": {
        "at": {
          "title": "At",
          "type": "number"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "ease": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ease"
        }
      },
      "required": [
        "at",
        "value"
      ],
      "title": "Keyframe",
      "type": "object"
    },
    "LinearEasing": {
      "description": "No easing: progress equals time.",
      "properties": {
        "kind": {
          "const": "linear",
          "default": "linear",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "LinearEasing",
      "type": "object"
    },
    "LinearGradient": {
      "description": "A CSS ``linear-gradient`` over the node's box.\n\n``angle`` is degrees in CSS semantics (0 up, 90 right). The gradient\nline runs through the box centre along ``(sin A, -cos A)`` and is\n``|w sin A| + |h cos A|`` long, so the stops land where CSS puts them.\nMaps 1:1 to CSS ``linear-gradient`` and SVG ``linearGradient``.",
      "properties": {
        "kind": {
          "const": "linear",
          "title": "Kind",
          "type": "string"
        },
        "angle": {
          "title": "Angle",
          "type": "number"
        },
        "stops": {
          "items": {
            "$ref": "#/$defs/PaintStop"
          },
          "title": "Stops",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "angle",
        "stops"
      ],
      "title": "LinearGradient",
      "type": "object"
    },
    "Node": {
      "description": "One node in the scene graph.\n\n``mask`` names a node whose alpha masks this one; ``clip`` is a CSS\n``clip-path`` (``inset()`` or ``polygon()``) in the node's box; ``blend``\nis a CSS ``mix-blend-mode``; ``filters`` is an ordered CSS filter list\napplied filter -> clip -> mask -> opacity; ``camera`` is this node's\ncamera content when it is a camera; ``tracks`` are multi-key tracks.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/NodeType"
        },
        "transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transform"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "opacity": {
          "default": 1.0,
          "title": "Opacity",
          "type": "number"
        },
        "bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bounds"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "z_index": {
          "default": 0,
          "title": "Z Index",
          "type": "integer"
        },
        "mask": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mask"
        },
        "clip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip"
        },
        "blend": {
          "default": "normal",
          "title": "Blend",
          "type": "string"
        },
        "filters": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/BlurFilter"
              },
              {
                "$ref": "#/$defs/DropShadowFilter"
              }
            ]
          },
          "title": "Filters",
          "type": "array"
        },
        "timing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timing"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "animations": {
          "items": {
            "$ref": "#/$defs/Animation"
          },
          "title": "Animations",
          "type": "array"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/Track"
          },
          "title": "Tracks",
          "type": "array"
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "shape": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShapeContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "video": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "svg": {
          "anyOf": [
            {
              "$ref": "#/$defs/SVGContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "shader": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShaderContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "camera": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "filter": {
          "anyOf": [
            {
              "$ref": "#/$defs/FilterContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/EffectContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "html": {
          "anyOf": [
            {
              "$ref": "#/$defs/HTMLContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "children": {
          "items": {
            "type": "string"
          },
          "title": "Children",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "Node",
      "type": "object"
    },
    "NodeType": {
      "description": "The node types the IR can express.\n\nThe five standard compositions exercise Scene, Ground, Group, Text,\nShape, Image and SVG. Camera, Video, Shader, Mask, Filter, Effect and\nAudio are modelled so a future composition needs no IR extension.",
      "enum": [
        "scene",
        "camera",
        "ground",
        "group",
        "text",
        "shape",
        "image",
        "video",
        "svg",
        "shader",
        "mask",
        "filter",
        "effect",
        "audio",
        "html"
      ],
      "title": "NodeType",
      "type": "string"
    },
    "PaintStop": {
      "description": "One gradient stop.\n\nStops interpolate PREMULTIPLIED: a stop that fades to transparent keeps\nits colour and sets ``opacity: 0`` rather than passing through black,\nthe way CSS ``linear-gradient`` to ``transparent`` behaves.",
      "properties": {
        "offset": {
          "title": "Offset",
          "type": "number"
        },
        "color": {
          "title": "Color",
          "type": "string"
        },
        "opacity": {
          "default": 1.0,
          "title": "Opacity",
          "type": "number"
        }
      },
      "required": [
        "offset",
        "color"
      ],
      "title": "PaintStop",
      "type": "object"
    },
    "PatternFill": {
      "description": "An image tile repeated across the node's box (the ground's grain).\n\n``src`` is a file path or data URI. ``tile_width`` / ``tile_height``\nare pixels; ``None`` uses the image's own size. Maps 1:1 to CSS\n``background-image: url(); background-repeat: repeat`` and SVG\n``pattern``.",
      "properties": {
        "src": {
          "title": "Src",
          "type": "string"
        },
        "tile_width": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tile Width"
        },
        "tile_height": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tile Height"
        },
        "opacity": {
          "default": 1.0,
          "title": "Opacity",
          "type": "number"
        }
      },
      "required": [
        "src"
      ],
      "title": "PatternFill",
      "type": "object"
    },
    "RadialGradient": {
      "description": "A CSS ``radial-gradient`` ellipse, radii in percent of the box.\n\nMaps 1:1 to CSS ``radial-gradient(ellipse ...)`` and SVG\n``radialGradient``.",
      "properties": {
        "kind": {
          "const": "radial",
          "title": "Kind",
          "type": "string"
        },
        "radius_x": {
          "title": "Radius X",
          "type": "number"
        },
        "radius_y": {
          "title": "Radius Y",
          "type": "number"
        },
        "stops": {
          "items": {
            "$ref": "#/$defs/PaintStop"
          },
          "title": "Stops",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "radius_x",
        "radius_y",
        "stops"
      ],
      "title": "RadialGradient",
      "type": "object"
    },
    "SVGContent": {
      "description": "The content of an SVG node: one path in ``viewBox`` units, scaled\nto fill the node's bounds.",
      "properties": {
        "viewBox": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Viewbox"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "fill": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LinearGradient"
            },
            {
              "$ref": "#/$defs/RadialGradient"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fill"
        }
      },
      "title": "SVGContent",
      "type": "object"
    },
    "ShaderContent": {
      "description": "The content of a Shader node.\n\n``program`` names a shader from a Ren-owned registry (vignette, cone,\ngrain, bokeh); ``uniforms`` are renderer-neutral names, animatable as\n``shader.<name>``; ``inputs`` are image names or ``pass:<group id>``\nfor the two-pass route (render a subtree, shade its pixels).",
      "properties": {
        "program": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Program"
        },
        "uniforms": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Uniforms",
          "type": "object"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        }
      },
      "title": "ShaderContent",
      "type": "object"
    },
    "ShapeContent": {
      "description": "The content of a Shape node.\n\n``fill`` is a colour or a gradient (``Paint``); ``pattern`` is an\nimage tile. ``clip`` on the node accepts ``inset()`` and ``polygon()``\nin the node's box, the CSS clip-path strings StagedScene already uses.",
      "properties": {
        "shape": {
          "title": "Shape",
          "type": "string"
        },
        "fill": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LinearGradient"
            },
            {
              "$ref": "#/$defs/RadialGradient"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fill"
        },
        "pattern": {
          "anyOf": [
            {
              "$ref": "#/$defs/PatternFill"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stroke": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stroke"
        },
        "stroke_width": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stroke Width"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "corner_radius": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corner Radius"
        }
      },
