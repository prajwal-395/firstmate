    "VideoContent": {
      "description": "The content of a Video node. ``src`` is a file path to the decoded\nvideo (a project-supplied file such as a brand sting mezzanine).\n\nThe node plays the file whole from its first frame in wall-clock\ntime at the scene rate (BrandMotion's ``native_sample``: composition\nframe ``i`` at ``t = i / fps`` shows source frame\n``round(t * source_fps)``, clamped - the mapping\n``docs/BRAND_MOTION_MEASURED.md`` measured in Remotion's\n``<OffthreadVideo>``). The renderer demuxes and decodes the file\nitself (straight-alpha RGBA, alpha intact where present) and draws\nthe mapped frame stretched over the node's bounds (CSS\n``object-fit: fill``, the composition's own fit). Geometry is\nrefused upstream when the source is not the delivery frame, so the\nstretch is 1:1 wherever the props were built honestly.",
      "properties": {
        "src": {
          "title": "Src",
          "type": "string"
        }
      },
      "required": [
        "src"
      ],
      "title": "VideoContent",
      "type": "object"
    }
