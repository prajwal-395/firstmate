      "step_ref": "steps/step_1_03_semantic_analysis",
      "type": "step",
      "estimated_duration_seconds": 600,
      "error_policy": {
        "policy": "retry",
        "max_retries": 2,
        "backoff_strategy": "exponential"
      }
    },
    {
      "id": "temporal_index",
