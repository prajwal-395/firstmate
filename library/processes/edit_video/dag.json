  "entry_nodes": [
    "scan",
    "validate_sfx_library"
  ],
  "exit_nodes": [
    "validate"
  ],
  "parallel_blocks": [
    {
      "id": "ingest_parallel",
      "fork_node": "scan",
      "join_node": "creative_direction",
      "branches": [
        [
          "catalog"
        ],
        [
          "semantic_analysis"
        ],
        [
          "temporal_index",
          "prosody_analysis"
        ]
      ],
      "error_policy": {
        "policy": "cascade",
        "escalation_enabled": true
      },
      "join_semantics": {
        "completion_model": "wait_for_all",
        "output_derivation": "merge_all"
      }
    },
    {
      "id": "postprod_parallel",
      "fork_node": "review_rough_cut",
      "join_node": "compile_manifest",
      "branches": [
        [
          "plan_subtitles",
          "render_subtitles"
        ],
        [
          "plan_transitions"
        ],
        [
          "plan_vfx"
        ],
        [
          "plan_sfx"
        ],
        [
          "color_grade"
        ],
        [
          "audio_mix"
        ]
      ],
      "error_policy": {
        "policy": "independent",
        "escalation_enabled": true
      },
      "join_semantics": {
        "completion_model": "wait_for_all",
        "output_derivation": "merge_all"
      }
    }
  ],
  "execution_environment": {
    "default": "local_macos"
  },
  "checkpoint_interval": 1
}