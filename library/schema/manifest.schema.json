{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manifest.schema.json",
  "title": "Process Library Component Manifest",
  "description": "Declares the interface contract, metadata, and implementation details for a process library component.",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "description",
    "level",
    "interface",
    "classification",
    "state",
    "dependencies",
    "tags",
    "domain",
    "implementation",
    "metadata"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema file."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Unique identifier. Matches the directory name. Lowercase with underscores."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable name."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version string (MAJOR.MINOR.PATCH)."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "Clear explanation of what this component does."
    },
    "level": {
      "type": "string",
      "enum": [
        "step",
        "sequence",
        "sub_process",
        "process",
        "pattern"
      ],
      "description": "Granularity level of this component."
    },
    "interface": {
      "type": "object",
      "required": [
        "inputs",
        "outputs"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/parameter"
          },
          "description": "Named input parameters with types and validation rules."
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/output_parameter"
          },
          "description": "Named return values with types."
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names of executable Requirements this step needs, from library/tools/requirements.py. REPLACED the prose 'preconditions' and 'postconditions' arrays, which were 126 strings across 29 manifests that nothing ever evaluated. Only the hand-written kinds are named here - predicate, environment and coverage. The state_key kind is AUTO-DERIVED from inputs[].required plus the DAG's data_mapping and must never be listed, because a second declaration of it is a second thing to drift."
        },
        "llm_outputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/output_parameter"
          },
          "description": "Outputs the LLM half of a hybrid step emits. Declared where a bridge emits a key the step also declares as an output; see AGENTS.md 10.1 and run_pipeline.py. Present on 9 manifests and previously absent from this schema, which nothing loads - added when the prose preconditions were removed so the schema describes what the manifests actually carry."
        },
        "context_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The prompt projection allow-list. NOTE: every other manifest carries this at the TOP LEVEL, which is where input_contract._reaches_prompt reads it; step_3_04_select_reels carries it here instead and is therefore not read. Described rather than silently rejected - the inconsistency is real and predates this schema edit."
        }
      },
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "required": [
        "stage",
        "determinism",
        "archetype",
        "idempotent"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "preflight",
            "edit"
          ],
          "description": "Which ledger records this step's completion. 'preflight' enriches this project's source footage and survives an edit reset; 'edit' sits downstream of a creative decision and is discarded by one. See library/tools/step_ledger.py."
        },
        "determinism": {
          "type": "string",
          "enum": [
            "deterministic",
            "nondeterministic"
          ],
          "description": "Whether identical inputs always produce identical outputs."
        },
        "archetype": {
          "type": "string",
          "enum": [
            "direct_action",
            "data_transformation",
            "information_retrieval",
            "content_generation",
            "evaluation_judgment",
            "human_handoff",
            "composite"
          ],
          "description": "The step's execution archetype from Step 3 Phase 1."
        },
        "idempotent": {
          "type": "boolean",
          "description": "Whether re-executing with the same inputs is safe (produces the same result without side effects)."
        },
        "per_clip_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Project-relative paths, one per clip, that this step writes and reuses when already present. May contain {clip_id} and {stem}. Declaring them is what makes --rerun <step>:<clip_id> possible."
        }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": [
        "reads",
        "writes"
      ],
      "properties": {
        "reads": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "State keys this component reads from."
        },
        "writes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "State keys this component writes to."
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Library entry IDs this component depends on. Empty array if none."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Searchable keywords for discovery."
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "description": "Functional domain (e.g., 'data-validation', 'notification', 'authentication')."
    },
    "implementation": {
      "type": "object",
      "required": [
        "default",
        "variants",
        "test_entry_point"
      ],
      "properties": {
        "default": {
          "type": "object",
          "required": [
            "runtime",
            "entry_point"
          ],
          "properties": {
            "runtime": {
              "type": "string",
              "description": "Language or runtime (bash, python, node, etc.)."
            },
            "entry_point": {
              "type": "string",
              "description": "The file to execute."
            }
          },
          "additionalProperties": false,
          "description": "Primary implementation used when no environment preference is specified."
        },
        "variants": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "runtime",
                  "entry_point"
                ],
                "properties": {
                  "runtime": {
                    "type": "string"
                  },
                  "entry_point": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "description": "Deterministic variant: environment -> script path."
              },
              {
                "type": "object",
                "required": [
                  "context_notes"
                ],
                "properties": {
                  "context_notes": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "description": "Nondeterministic variant: environment -> context notes for prompt injection."
              }
            ]
          },
          "description": "Environment-keyed variant mapping. Empty object if no variants."
        },
        "test_entry_point": {
          "type": "string",
          "description": "Test script that validates the implementation against the interface contract."
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": [
        "author",
        "created",
        "last_modified"
      ],
      "properties": {
        "author": {
          "type": "string",
          "description": "Who created this component."
        },
        "created": {
          "type": "string",
          "format": "date",
          "description": "Creation date (YYYY-MM-DD)."
        },
        "last_modified": {
          "type": "string",
          "format": "date",
          "description": "Last modification date (YYYY-MM-DD)."
        },
        "source_process": {
          "type": "string",
          "description": "The process this component was originally extracted from."
        },
        "notes": {
          "type": "string",
          "description": "Additional context or notes about this component."
        }
      },
      "additionalProperties": false
    },
    "composition": {
      "$ref": "#/definitions/composition",
      "description": "Present for sequences, sub-processes, and processes. Defines how sub-components are organized."
    }
  },
  "additionalProperties": false,
  "if": {
    "properties": {
      "level": {
        "enum": [
          "sequence",
          "sub_process",
          "process"
        ]
      }
    }
  },
  "then": {
    "required": [
      "composition"
    ]
  },
  "definitions": {
    "parameter": {
      "type": "object",
      "required": [
        "name",
        "type",
        "required",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Parameter name."
        },
        "type": {
          "type": "string",
          "description": "Data type (string, number, boolean, array, object, or union with '|')."
        },
        "required": {
          "type": "boolean",
          "description": "Whether this parameter is required."
        },
        "description": {
          "type": "string",
          "description": "What this parameter represents."
        },
        "validation": {
          "type": "string",
          "description": "Validation rule or constraint."
        },
        "default": {
          "description": "Default value if not provided. Only valid when required is false."
        }
      },
      "additionalProperties": false
    },
    "output_parameter": {
      "type": "object",
      "required": [
        "name",
        "type",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Output name."
        },
        "type": {
          "type": "string",
          "description": "Data type."
        },
        "description": {
          "type": "string",
          "description": "What this output represents."
        }
      },
      "additionalProperties": false
    },
    "composition": {
      "type": "object",
      "required": [
        "type",
        "definition_file",
        "components"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "sequence",
            "dag",
            "pattern_instance"
          ],
          "description": "How sub-components are organized."
        },
        "definition_file": {
          "type": "string",
          "description": "File containing the composition logic (sequence.json, dag.json, etc.)."
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "step_ref",
              "version_constraint",
              "role"
            ],
            "properties": {
              "step_ref": {
                "type": "string",
                "description": "Path to the referenced library entry (relative to library root)."
              },
              "version_constraint": {
                "type": "string",
                "description": "Semantic version range (e.g., '>=1.0.0 <2.0.0')."
              },
              "role": {
                "type": "string",
                "description": "What role this component plays in the composition."
              }
            },
            "additionalProperties": false
          }
        },
        "pattern_ref": {
          "type": "string",
          "description": "Reference to a pattern template, if this is a pattern instantiation."
        }
      },
      "additionalProperties": false
    }
  }
}
