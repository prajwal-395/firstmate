# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# ─── Environment (machine-specific, use .env.example as template) ─
.env

# ─── macOS ───────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ─── Editors / IDEs ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Agent tooling (managed by tooling, not by user) ────────
.agents/mcp/
.lavish/

# ─── Separate repos ─────────────────────────────────────────
palmier-pro/

# ─── Node.js ─────────────────────────────────────────────────
node_modules/

# ─── Remotion generated props (regenerated per video project) ─
remotion-subtitles/public/*Props.json

# ─── Media files (too large for git) ────────────────────────
*.mov
*.mp4
*.mp3
*.wav
*.aac
*.m4a
*.avi
*.mkv

# ─── DaVinci Resolve binary files ───────────────────────────
*.drp
*.drb

# ─── Generated pipeline outputs ─────────────────────────────
# Step JSON outputs (regenerated per project run)
library/steps/*/step_*.json

# Generated Fusion .comp files (regenerated by pipeline)
library/steps/step_6_01_render/fusion_comps/

# Exported Resolve project files
library/steps/step_6_01_render/drp_exports/

# Root pipeline artifacts
/pipeline_output/
/.vision_cache/

# ─── Project data (lives in PROJECTS_ROOT, not in the repo) ──
# These directories contain project-specific assets that are
# managed by the project registry and should not be in git.
projects/
Lucie Podcast/

# ─── Build / temp artifacts ─────────────────────────────────
*.log
/tmp/
.env
.venv/
/pr_body.md

# local convenience launcher, not shared
/dash
