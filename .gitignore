# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# ─── macOS ───────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ─── Editors / IDEs ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Antigravity / MCP (managed by tooling, not by user) ────
.agents/mcp/

# ─── Separate repos ─────────────────────────────────────────
palmier-pro/

# ─── Node.js ─────────────────────────────────────────────────
node_modules/

# ─── Media files (too large for git) ────────────────────────
*.mov
*.mp4
*.mp3
*.wav
*.aac
*.m4a
*.avi
*.mkv

# ─── DaVinci Resolve binary files ───────────────────────────
*.drp
*.drb

# ─── Generated pipeline outputs ─────────────────────────────
# Step JSON outputs (regenerated per project run)
library/steps/*/step_*.json

# Generated Fusion .comp files (regenerated by pipeline)
library/steps/step_6_01_render/fusion_comps/

# Exported Resolve project files
library/steps/step_6_01_render/drp_exports/

# ─── Build / temp artifacts ─────────────────────────────────
*.log
/tmp/
