# ─── Pipeline Configuration ──────────────────────────────────
# Copy this file to `.env` and customize for your machine.
# The pipeline loads these values at import time via library/tools/paths.py.

# ── External Asset Libraries ─────────────────────────────────
# Absolute path to the SFX audio library (contains .mp3/.wav files + profiles/)
PIPELINE_SFX_LIBRARY="/Users/prajwal/Documents/content_stuff/assets i used (just copied here for convenience)/sfx library"

# ── DaVinci Resolve Paths ────────────────────────────────────
# Resolve application support directory (rarely needs changing)
# RESOLVE_SUPPORT_DIR="$HOME/Library/Application Support/Blackmagic Design/DaVinci Resolve"

# Resolve scripting API paths (only change if using a non-standard Resolve install)
# RESOLVE_SCRIPT_API="/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting"
# RESOLVE_SCRIPT_LIB="/Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Libraries/Fusion/fusionscript.so"

# ── Pipeline Behavior ────────────────────────────────────────
# Namespace used inside Resolve's directories for symlinked assets (default: "Pipeline")
# RESOLVE_SYNC_NAMESPACE="Pipeline"
