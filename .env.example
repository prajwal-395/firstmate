# ─── Pipeline Configuration ──────────────────────────────────
# Prefer the per-user file `~/.config/ren/config.env` (`ren config --init`):
# one per machine, outside every checkout. It uses this same format and wins
# over a checkout's `.env`; an exported variable wins over both.
# To configure ONE checkout instead, copy this file to `.env`.
# library/tools/paths.py loads both at import time.

# ── Video Projects ───────────────────────────────────────────
# Root directory where video projects live (each project is a subdirectory
# containing project.yaml, raw/, pipeline_output/, exports/).
# Projects are separate from this repo - the repo is the engine, projects are the data.
PIPELINE_PROJECTS_ROOT="$HOME/Movies/Ren/projects"

# ── External Asset Libraries ─────────────────────────────────
# Root directory for shared assets (SFX, music, etc.)
# Individual paths below default to subdirectories of this root.
PIPELINE_SHARED_ASSETS="$HOME/Movies/Ren/assets"

# Absolute path to the SFX audio library (contains .mp3/.wav files + profiles/)
PIPELINE_SFX_LIBRARY="$HOME/Movies/Ren/assets/sfx library"

# Absolute path to the music library
PIPELINE_MUSIC_LIBRARY="$HOME/Movies/Ren/assets/music"

# ── API Tokens ───────────────────────────────────────────────
# HuggingFace token for downloading gated models like Audio Flamingo
HF_TOKEN=your_huggingface_token_here

# ── DaVinci Resolve Paths ────────────────────────────────────
# Resolve application support directory (rarely needs changing)
# RESOLVE_SUPPORT_DIR="$HOME/Library/Application Support/Blackmagic Design/DaVinci Resolve"

# Resolve scripting API paths (only change if using a non-standard Resolve install)
# RESOLVE_SCRIPT_API="/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting"
# RESOLVE_SCRIPT_LIB="/Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Libraries/Fusion/fusionscript.so"

# ── Pipeline Behavior ────────────────────────────────────────
# Namespace used inside Resolve's directories for symlinked assets (default: "Pipeline")
# RESOLVE_SYNC_NAMESPACE="Pipeline"
