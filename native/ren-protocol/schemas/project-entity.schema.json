{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entity",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "identity_scope": {
      "description": "Lane 3: how widely this identity holds. `None` for records\nmigrated before scopes existed, so older documents still decode.",
      "anyOf": [
        {
          "$ref": "#/$defs/IdentityScope"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "$ref": "#/$defs/EntityKind"
    },
    "label": {
      "type": [
        "string",
        "null"
      ]
    },
    "object_class_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "kind"
  ],
  "$defs": {
    "EntityKind": {
      "type": "string",
      "enum": [
        "person",
        "object",
        "scene",
        "speaker",
        "camera",
        "other"
      ]
    },
    "IdentityScope": {
      "type": "string",
      "enum": [
        "asset",
        "capture_group",
        "project",
        "cross_project"
      ]
    }
  }
}