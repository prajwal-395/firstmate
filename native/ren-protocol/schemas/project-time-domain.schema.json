{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TimeDomain",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "source"
        },
        "stream_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "asset_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "project"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "timeline"
        },
        "timeline_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "timeline_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "render"
        },
        "render_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "render_id"
      ]
    }
  ]
}