{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signal",
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "string"
    },
    "estimate_status": {
      "description": "Epistemic qualifier for derived signals; separate from processing status.",
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "interval": {
      "$ref": "#/$defs/Interval"
    },
    "measurement_type": {
      "type": "string"
    },
    "processing_status": {
      "$ref": "#/$defs/ProcessingStatus"
    },
    "provenance_id": {
      "type": "string"
    },
    "sample_clock_id": {
      "type": "string"
    },
    "samples": {
      "type": "array",
      "items": true
    },
    "samples_ref": {
      "description": "Relative artifact reference for samples stored outside the model JSON.",
      "type": [
        "string",
        "null"
      ]
    },
    "source_signal_id": {
      "description": "The source signal from which this derived signal was produced.",
      "type": [
        "string",
        "null"
      ]
    },
    "unit": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "asset_id",
    "interval",
    "measurement_type",
    "unit",
    "samples",
    "sample_clock_id",
    "provenance_id",
    "processing_status"
  ],
  "$defs": {
    "Interval": {
      "description": "Half-open integer tick range [start, end); `start < end` is required by validation.",
      "type": "object",
      "properties": {
        "clock_id": {
          "type": "string"
        },
        "end": {
          "type": "integer",
          "format": "int64"
        },
        "start": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "clock_id",
        "start",
        "end"
      ]
    },
    "ProcessingStatus": {
      "description": "Pipeline state is coverage metadata, never a certainty value.",
      "type": "string",
      "enum": [
        "analyzed",
        "not_analyzed",
        "unavailable",
        "failed",
        "inconclusive"
      ]
    }
  }
}