{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceStream",
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "string"
    },
    "clock_id": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "stream_index": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "asset_id",
    "stream_index",
    "clock_id",
    "metadata"
  ]
}