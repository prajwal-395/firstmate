{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clock",
  "type": "object",
  "properties": {
    "domain": {
      "$ref": "#/$defs/TimeDomain"
    },
    "frame_rate": {
      "anyOf": [
        {
          "$ref": "#/$defs/Rational"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string"
    },
    "ticks_per_second": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "domain",
    "ticks_per_second"
  ],
  "$defs": {
    "Rational": {
      "type": "object",
      "properties": {
        "denominator": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "numerator": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "TimeDomain": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "asset_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "source"
            },
            "stream_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "asset_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "project"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "timeline"
            },
            "timeline_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "timeline_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "render"
            },
            "render_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "render_id"
          ]
        }
      ]
    }
  }
}