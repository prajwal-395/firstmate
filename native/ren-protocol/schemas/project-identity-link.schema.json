{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IdentityLink",
  "type": "object",
  "properties": {
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "confidence_detail": {
      "anyOf": [
        {
          "$ref": "#/$defs/TypedConfidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "contradicting_observation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entity_id": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "method_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "observation_id": {
      "type": "string"
    },
    "provenance_id": {
      "type": "string"
    },
    "scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/Interval"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "#/$defs/IdentityStatus"
    },
    "supporting_observation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "track_id": {
      "description": "Lane 3: the local track this link re-associates. `None` for\nobservation-anchored links written before tracks were named.",
      "type": [
        "string",
        "null"
      ]
    },
    "uncertainty": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "verification_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationStatus"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "entity_id",
    "observation_id",
    "method",
    "status",
    "provenance_id"
  ],
  "$defs": {
    "ConfidenceKind": {
      "type": "string",
      "enum": [
        "rank",
        "logit",
        "cosine",
        "calibrated_probability",
        "uncertainty",
        "raw_score"
      ]
    },
    "IdentityStatus": {
      "type": "string",
      "enum": [
        "candidate",
        "verified"
      ]
    },
    "Interval": {
      "description": "Half-open integer tick range [start, end); `start < end` is required by validation.",
      "type": "object",
      "properties": {
        "clock_id": {
          "type": "string"
        },
        "end": {
          "type": "integer",
          "format": "int64"
        },
        "start": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "clock_id",
        "start",
        "end"
      ]
    },
    "TypedConfidence": {
      "type": "object",
      "properties": {
        "calibration_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ConfidenceKind"
        },
        "population": {
          "type": [
            "string",
            "null"
          ]
        },
        "producer": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "kind",
        "producer"
      ]
    },
    "VerificationStatus": {
      "type": "string",
      "enum": [
        "unverified",
        "candidate",
        "verified",
        "retracted"
      ]
    }
  }
}