{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoverageScope",
  "type": "object",
  "properties": {
    "coordinate_space_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "interval": {
      "anyOf": [
        {
          "$ref": "#/$defs/Interval"
        },
        {
          "type": "null"
        }
      ]
    },
    "target_entity_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Interval": {
      "description": "Half-open integer tick range [start, end); `start < end` is required by validation.",
      "type": "object",
      "properties": {
        "clock_id": {
          "type": "string"
        },
        "end": {
          "type": "integer",
          "format": "int64"
        },
        "start": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "clock_id",
        "start",
        "end"
      ]
    }
  }
}