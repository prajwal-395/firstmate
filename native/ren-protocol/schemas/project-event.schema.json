{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "type": "object",
  "properties": {
    "certainty": {
      "$ref": "#/$defs/CertaintyState"
    },
    "confidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/TypedConfidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "end_boundary": {
      "anyOf": [
        {
          "$ref": "#/$defs/TemporalBoundary"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "id": {
      "type": "string"
    },
    "interval": {
      "$ref": "#/$defs/Interval"
    },
    "kind": {
      "type": "string"
    },
    "parent_event_ids": {
      "description": "Canonical parent events for multiresolution retrieval. Several\nparents are allowed because a fine event can belong to both a scene\nand a longer sequence.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "participant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "start_boundary": {
      "description": "Boundary quality is independent for the two ends. The interval stays\na non-empty half-open envelope on its source clock; `open` means the\nsemantic boundary was outside observed coverage.",
      "anyOf": [
        {
          "$ref": "#/$defs/TemporalBoundary"
        },
        {
          "type": "null"
        }
      ]
    },
    "state_changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EventStateChange"
      }
    },
    "status": {
      "$ref": "#/$defs/VerificationStatus"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "interval",
    "kind",
    "participant_ids",
    "status",
    "certainty",
    "evidence_ids"
  ],
  "$defs": {
    "BoundaryStatus": {
      "type": "string",
      "enum": [
        "exact",
        "estimated",
        "open"
      ]
    },
    "CertaintyState": {
      "description": "Canonical epistemic category. These values are orthogonal to confidence.",
      "type": "string",
      "enum": [
        "observed",
        "measured",
        "inferred",
        "interpreted"
      ]
    },
    "ConfidenceKind": {
      "type": "string",
      "enum": [
        "rank",
        "logit",
        "cosine",
        "calibrated_probability",
        "uncertainty",
        "raw_score"
      ]
    },
    "EventStateChange": {
      "description": "A measured or inferred property transition belonging to an event.",
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "from": true,
        "property": {
          "type": "string"
        },
        "to": true
      },
      "additionalProperties": false,
      "required": [
        "entity_id",
        "property",
        "evidence_ids"
      ]
    },
    "Interval": {
      "description": "Half-open integer tick range [start, end); `start < end` is required by validation.",
      "type": "object",
      "properties": {
        "clock_id": {
          "type": "string"
        },
        "end": {
          "type": "integer",
          "format": "int64"
        },
        "start": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "clock_id",
        "start",
        "end"
      ]
    },
    "TemporalBoundary": {
      "description": "Uncertainty radius around an interval edge, expressed in that clock's ticks.",
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/BoundaryStatus"
        },
        "uncertainty_ticks": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "status"
      ]
    },
    "TypedConfidence": {
      "type": "object",
      "properties": {
        "calibration_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ConfidenceKind"
        },
        "population": {
          "type": [
            "string",
            "null"
          ]
        },
        "producer": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "kind",
        "producer"
      ]
    },
    "VerificationStatus": {
      "type": "string",
      "enum": [
        "unverified",
        "candidate",
        "verified",
        "retracted"
      ]
    }
  }
}