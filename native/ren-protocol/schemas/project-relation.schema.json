{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relation",
  "type": "object",
  "properties": {
    "certainty": {
      "anyOf": [
        {
          "$ref": "#/$defs/CertaintyState"
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "id": {
      "type": "string"
    },
    "interval": {
      "$ref": "#/$defs/Interval"
    },
    "object_id": {
      "type": "string"
    },
    "predicate": {
      "type": "string"
    },
    "provenance_id": {
      "type": "string"
    },
    "relation_class": {
      "description": "Lane 3: temporal edges are computable from clock-aligned\nintervals; physical edges need spatial/track evidence and stay\ncandidates until verified; semantic edges need\ninterpretation-level support and stay interpreted candidates.\n`None` for relations migrated before classes existed.",
      "anyOf": [
        {
          "$ref": "#/$defs/RelationClass"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject_id": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "subject_id",
    "predicate",
    "object_id",
    "interval",
    "provenance_id"
  ],
  "$defs": {
    "CertaintyState": {
      "description": "Canonical epistemic category. These values are orthogonal to confidence.",
      "type": "string",
      "enum": [
        "observed",
        "measured",
        "inferred",
        "interpreted"
      ]
    },
    "Interval": {
      "description": "Half-open integer tick range [start, end); `start < end` is required by validation.",
      "type": "object",
      "properties": {
        "clock_id": {
          "type": "string"
        },
        "end": {
          "type": "integer",
          "format": "int64"
        },
        "start": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "clock_id",
        "start",
        "end"
      ]
    },
    "RelationClass": {
      "type": "string",
      "enum": [
        "temporal",
        "physical",
        "semantic"
      ]
    },
    "VerificationStatus": {
      "type": "string",
      "enum": [
        "unverified",
        "candidate",
        "verified",
        "retracted"
      ]
    }
  }
}