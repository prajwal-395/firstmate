{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpaceTransform",
  "type": "object",
  "properties": {
    "from_space": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "matrix": {
      "description": "Row-major homogeneous matrix; dimensions are checked by the owner that applies it.",
      "type": "array",
      "items": {
        "type": "number",
        "format": "double"
      }
    },
    "provenance_id": {
      "type": "string"
    },
    "to_space": {
      "type": "string"
    },
    "uncertainty": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "from_space",
    "to_space",
    "matrix",
    "provenance_id"
  ]
}