{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceContract",
  "description": "FI-03: one versioned measurement record (plan A2) - asset, interval\non a named clock (the observation's own), target entity/region,\ntype/value/unit/method/sample-resolution, coverage and provenance.\nMirrors `library/tools/evidence_contract.py::to_rust_evidence`;\nthe Python key set is pinned by test against these serde names.",
  "type": "object",
  "properties": {
    "basis_measurement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "basis_rule_ids": {
      "description": "FI-22: stable IDs of the policy rules applied by this evaluation.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "certainty": {
      "anyOf": [
        {
          "$ref": "#/$defs/CertaintyState"
        },
        {
          "type": "null"
        }
      ]
    },
    "contract_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "coordinate_space_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "coverage": {
      "$ref": "#/$defs/CoverageKind"
    },
    "coverage_level": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalysisLevel"
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage_sample_rate_hz": {
      "type": "number",
      "format": "double"
    },
    "coverage_samples": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "coverage_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoverageScope"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_type": {
      "$ref": "#/$defs/EvidenceType"
    },
    "freshness": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoverageFreshness"
        },
        {
          "type": "null"
        }
      ]
    },
    "measurement_type": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "policy_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "processing_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProcessingStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "producer_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      }
    },
    "sample_resolution": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      },
      "maxItems": 2,
      "minItems": 2
    },
    "source_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "spatial_frame_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_region": {
      "type": [
        "string",
        "null"
      ]
    },
    "uncertainty": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "unit": {
      "type": "string"
    },
    "value": true
  },
  "additionalProperties": false,
  "required": [
    "evidence_type",
    "measurement_type",
    "value",
    "unit",
    "method",
    "coverage",
    "coverage_samples",
    "coverage_sample_rate_hz",
    "basis_measurement_ids",
    "contract_version"
  ],
  "$defs": {
    "AnalysisLevel": {
      "type": "string",
      "enum": [
        "l0",
        "l1",
        "l2"
      ]
    },
    "CertaintyState": {
      "description": "Canonical epistemic category. These values are orthogonal to confidence.",
      "type": "string",
      "enum": [
        "observed",
        "measured",
        "inferred",
        "interpreted"
      ]
    },
    "CoverageFreshness": {
      "type": "string",
      "enum": [
        "fresh",
        "stale",
        "unknown"
      ]
    },
    "CoverageKind": {
      "description": "FI-03 provenance + coverage semantics (plan C4 + A2 item 7).\n`Unavailable` means unmeasured - the lane never looked. A measured\nabsence is `Complete` with zero samples instead.",
      "type": "string",
      "enum": [
        "complete",
        "sampled",
        "inferred",
        "unavailable"
      ]
    },
    "CoverageScope": {
      "type": "object",
      "properties": {
        "coordinate_space_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_entity_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "EvidenceReference": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "source_sample"
            },
            "sample_index": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "stream_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "stream_id",
            "sample_index"
          ]
        },
        {
          "type": "object",
          "properties": {
            "frame_index": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "source_frame"
            },
            "stream_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "stream_id",
            "frame_index"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "observation"
            },
            "observation_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "observation_id"
          ]
        }
      ]
    },
    "EvidenceType": {
      "description": "FI-03: the four evidence types (plan A1). A raw instrument value\nlives under `Measurement` and must never inhabit `Evaluation`.",
      "type": "string",
      "enum": [
        "measurement",
        "inference",
        "evaluation",
        "creative_judgment"
      ]
    },
    "Interval": {
      "description": "Half-open integer tick range [start, end); `start < end` is required by validation.",
      "type": "object",
      "properties": {
        "clock_id": {
          "type": "string"
        },
        "end": {
          "type": "integer",
          "format": "int64"
        },
        "start": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "clock_id",
        "start",
        "end"
      ]
    },
    "ProcessingStatus": {
      "description": "Pipeline state is coverage metadata, never a certainty value.",
      "type": "string",
      "enum": [
        "analyzed",
        "not_analyzed",
        "unavailable",
        "failed",
        "inconclusive"
      ]
    }
  }
}