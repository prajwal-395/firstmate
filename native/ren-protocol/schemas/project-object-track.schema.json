{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObjectTrack",
  "type": "object",
  "properties": {
    "clock_id": {
      "type": "string"
    },
    "continuity": {
      "type": [
        "string",
        "null"
      ]
    },
    "coverage": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProcessingStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "entity_id": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "local_track_id": {
      "description": "Lane 3: the tracker's clip-local id, distinct from the durable\nentity id. `None` for tracks migrated before local ids existed.",
      "type": [
        "string",
        "null"
      ]
    },
    "provenance_id": {
      "type": "string"
    },
    "samples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TrackSample"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "entity_id",
    "clock_id",
    "samples",
    "provenance_id"
  ],
  "$defs": {
    "ConfidenceKind": {
      "type": "string",
      "enum": [
        "rank",
        "logit",
        "cosine",
        "calibrated_probability",
        "uncertainty",
        "raw_score"
      ]
    },
    "Interval": {
      "description": "Half-open integer tick range [start, end); `start < end` is required by validation.",
      "type": "object",
      "properties": {
        "clock_id": {
          "type": "string"
        },
        "end": {
          "type": "integer",
          "format": "int64"
        },
        "start": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "clock_id",
        "start",
        "end"
      ]
    },
    "ProcessingStatus": {
      "description": "Pipeline state is coverage metadata, never a certainty value.",
      "type": "string",
      "enum": [
        "analyzed",
        "not_analyzed",
        "unavailable",
        "failed",
        "inconclusive"
      ]
    },
    "TrackSample": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "confidence_detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/TypedConfidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "coordinate_space": {
          "type": "string"
        },
        "coordinate_space_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "geometry": true,
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ]
        },
        "space_transform_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tick": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "tick",
        "geometry",
        "coordinate_space"
      ]
    },
    "TypedConfidence": {
      "type": "object",
      "properties": {
        "calibration_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ConfidenceKind"
        },
        "population": {
          "type": [
            "string",
            "null"
          ]
        },
        "producer": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "kind",
        "producer"
      ]
    }
  }
}