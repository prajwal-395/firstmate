{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Effect",
  "description": "Effect declaration and supported picture-transform parameter conventions.\n`transform.position` uses `parameters.position: [x, y]` in sequence\npixels or timed `[x, y]` keyframes. `transform.scale` uses a uniform\npositive multiplicative factor (`1.0` is unchanged) in\n`parameters.scale` or numeric keyframes. Static\ntransforms cover the full target clip use; keyframed transforms may\nvary within their interval.",
  "type": "object",
  "properties": {
    "class_id": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "interval": {
      "$ref": "#/$defs/Interval"
    },
    "keyframes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Keyframe"
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "target_id": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "class_id",
    "target_id",
    "interval",
    "parameters",
    "keyframes"
  ],
  "$defs": {
    "Interval": {
      "description": "Half-open integer tick range [start, end); `start < end` is required by validation.",
      "type": "object",
      "properties": {
        "clock_id": {
          "type": "string"
        },
        "end": {
          "type": "integer",
          "format": "int64"
        },
        "start": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "clock_id",
        "start",
        "end"
      ]
    },
    "Keyframe": {
      "type": "object",
      "properties": {
        "tick": {
          "type": "integer",
          "format": "int64"
        },
        "value": true
      },
      "additionalProperties": false,
      "required": [
        "tick",
        "value"
      ]
    }
  }
}