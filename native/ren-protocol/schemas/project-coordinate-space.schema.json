{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoordinateSpace",
  "type": "object",
  "properties": {
    "asset_id": {
      "description": "The source whose grid this space is, when it belongs to one. A\nspace with no owner is a grid in the air: a place in it cannot\nbe located in any file.",
      "type": [
        "string",
        "null"
      ]
    },
    "axes": {
      "type": "string"
    },
    "calibration": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "units": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "units",
    "origin",
    "axes"
  ]
}