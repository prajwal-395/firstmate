{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interpretation",
  "type": "object",
  "properties": {
    "author": {
      "type": "string"
    },
    "certainty": {
      "$ref": "#/$defs/CertaintyState"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "narrative_relation": {
      "anyOf": [
        {
          "$ref": "#/$defs/NarrativeRelation"
        },
        {
          "type": "null"
        }
      ]
    },
    "objective": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": true,
    "uncertainty": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "author",
    "evidence_ids",
    "scope",
    "certainty"
  ],
  "$defs": {
    "CertaintyState": {
      "description": "Canonical epistemic category. These values are orthogonal to confidence.",
      "type": "string",
      "enum": [
        "observed",
        "measured",
        "inferred",
        "interpreted"
      ]
    },
    "NarrativeHypothesisStatus": {
      "type": "string",
      "enum": [
        "candidate"
      ]
    },
    "NarrativeRelation": {
      "description": "Typed narrative relation hypothesis scoped to speech and event evidence.",
      "type": "object",
      "properties": {
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relation_type": {
          "$ref": "#/$defs/NarrativeRelationKind"
        },
        "speech_passage_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/$defs/NarrativeHypothesisStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "relation_type",
        "speech_passage_ids",
        "event_ids",
        "status"
      ]
    },
    "NarrativeRelationKind": {
      "type": "string",
      "enum": [
        "claim",
        "topic",
        "explanation",
        "demonstration",
        "context_dependency"
      ]
    }
  }
}