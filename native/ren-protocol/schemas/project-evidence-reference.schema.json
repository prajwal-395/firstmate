{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceReference",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "source_sample"
        },
        "sample_index": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "stream_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "stream_id",
        "sample_index"
      ]
    },
    {
      "type": "object",
      "properties": {
        "frame_index": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "const": "source_frame"
        },
        "stream_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "stream_id",
        "frame_index"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "observation"
        },
        "observation_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "observation_id"
      ]
    }
  ]
}