{
  "version": 2,
  "rules": [
    {
      "id": "open-ended",
      "when": "Work that remains genuinely open-ended after intake.",
      "trigger": { "kind": "declaration" },
      "ladder": [
        {
          "id": "opus-5-5",
          "harness": "claude",
          "model": "claude-opus-5-5",
          "provider": "anthropic",
          "effort": "medium",
          "approval": "captain"
        }
      ]
    },
    {
      "id": "work-belongs-to-a-lucie--2",
      "when": "Work belongs to a LUCIE project: business-finder-lucie, lucie-geo-backend, lucie-outreach, lucie-geo-cta, lucie-eval-system, business-finder, forest-city-site, foothills-site, starling-site, oakmont-site, or any other Lucie-Content repo, including work routed to the lucie second mate.",
      "trigger": {
        "kind": "projects",
        "names": [
          "business-finder",
          "business-finder-lucie",
          "foothills-site",
          "forest-city-site",
          "lucie-eval-system",
          "lucie-geo-backend",
          "lucie-geo-cta",
          "lucie-lead-analysis",
          "lucie-outreach",
          "oakmont-site",
          "starling-site",
          "wfa-site"
        ]
      },
      "ladder": [
        {
          "id": "gemini-flash",
          "harness": "agy",
          "model": "gemini-3.8-flash-high",
          "provider": "google",
          "effort": "high"
        },
        {
          "id": "opus-4-6-thinking",
          "harness": "agy",
          "model": "claude-opus-4-6-thinking",
          "provider": "anthropic",
          "effort": "high",
          "approval": "captain"
        }
      ]
    }
  ],
  "default_ladder": [
    {
      "id": "deepseek-free",
      "harness": "opencode",
      "model": "opencode/deepseek-v4.1-flash-free",
      "provider": "opencode",
      "accounts": ["secondary", "main"],
      "account_strategy": "ordered"
    },
    {
      "id": "glm-free",
      "harness": "opencode",
      "model": "opencode/glm-5.3-flash-free",
      "provider": "opencode",
      "accounts": ["secondary", "main"],
      "account_strategy": "ordered"
    },
    {
      "id": "mimo-free",
      "harness": "opencode",
      "model": "opencode/mimo-v2.6-flash-free",
      "provider": "opencode",
      "accounts": ["secondary", "main"],
      "account_strategy": "ordered"
    },
    {
      "id": "codex-luna",
      "harness": "codex",
      "model": "gpt-6-luna",
      "provider": "codex",
      "effort": "medium"
    },
    {
      "id": "muse-go",
      "harness": "opencode",
      "model": "opencode-go/muse-spark-1.3-contributor",
      "provider": "opencode-go",
      "accounts": ["main", "secondary"],
      "account_strategy": "reset-soonest-yield-shorter-reset"
    }
  ],
  "constraints": [
    {
      "id": "worker-claude-approval",
      "when": { "scope": "worker", "provider": "anthropic" },
      "approval": "captain"
    },
    {
      "id": "research-no-claude",
      "when": { "home_role": "research", "provider": "anthropic" },
      "deny": true
    }
  ],
  "providers": [
    {
      "id": "opencode",
      "refusal_patterns": [
        { "pattern": "free usage exceeded", "reset": "retry-after-iso8601-or-next-utc-day" },
        { "pattern": "subscribe to go", "reset": "retry-after-iso8601-or-next-utc-day" }
      ]
    },
    {
      "id": "opencode-go",
      "refusal_patterns": [
        { "pattern": "free usage exceeded|subscribe to go", "reset": "retry-after-iso8601-or-next-utc-day" },
        { "pattern": "usage limit", "reset": "provider-reset-time-or-quota-axi" }
      ]
    },
    {
      "id": "codex",
      "refusal_patterns": [
        { "pattern": "usage limit", "reset": "provider-reset-time-or-quota-axi" }
      ]
    },
    {
      "id": "anthropic",
      "refusal_patterns": [
        { "pattern": "usage limit", "reset": "provider-reset-time-or-quota-axi" }
      ]
    },
    {
      "id": "google",
      "refusal_patterns": [
        { "pattern": "usage limit", "reset": "provider-reset-time-or-quota-axi" }
      ]
    }
  ]
}
