{
 "schema": "ren_detection_coverage_manifest/1",
 "task": "D-01",
 "purpose": "Measured detection coverage across object categories on real footage, with denominators.",
 "label_source": "One agent adjudicator (the lane's own worker) looked at every frame and labelled every instance of the taxonomy classes it could see. Boxes are visual estimates on the native frame, normalized 0..1, top-left origin. No human gold labels and no second adjudicator: these are agent labels, and the report says so.",
 "labelling_rules": {
  "exhaustive_within_taxonomy": "Every visible instance of a taxonomy class in a frame is labelled, so an unmatched detection of that class is a false positive rather than an unlabelled instance.",
  "classes": {
   "person": "a human body in the scene, including a partly framed one",
   "hand": "a hand, including one entering from a frame edge",
   "phone": "a handheld phone",
   "laptop": "an open or closed laptop computer",
   "cup": "a drinking vessel (cup, mug, glass)",
   "small_object": "a discrete object that is not one of the classes above and is small in the frame (glasses, a camera on a tripod, a plant pot, a lamp, a ceiling speaker, a light switch, a hanging device, a door handle, a side mirror, a backpack strap)"
  },
  "small_object_is_measured_not_asserted": "An instance is also counted in the SMALL stratum when its box area is under 1% of the frame, whatever its class.",
  "partially_visible_is_measured_not_asserted": "An instance is also counted in the PARTIAL stratum when its box touches a frame edge, whatever its class.",
  "unusual_footage_is_a_frame_property": "unusual_footage marks frames that are not the studio podcast setup: in-car dashcam footage, handheld vertical selfie footage and street walk-and-talk footage."
 },
 "matching": {
  "iou_threshold": 0.5,
  "score_threshold": 0.1,
  "one_to_one": "A detection matches at most one labelled instance and an instance is recalled by at most one detection (maximum-cardinality matching, as the bakeoff does).",
  "class_conditioned": "A detection answers one query phrase and matches only an instance whose query phrase is the same phrase, except the class-agnostic Apple Vision foreground proposal, which may match any instance."
 },
 "detectors": {
  "owlv2": "open-vocabulary, the incumbent (google/owlv2-base-patch16-ensemble, MPS float32)",
  "rf_detr_nano": "fixed-vocabulary COCO detector mapped onto the query phrases (Roboflow/rf-detr-nano, MPS float32)",
  "vision_foreground": "class-agnostic Apple Vision foreground proposals (no phrase, so no per-class precision)"
 },
